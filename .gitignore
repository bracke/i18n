# GNAT/GPRbuild output
obj/
lib/
tests/bin/
/*.ali
/*.o

# Alire/local tool state
alire/
.alire/

# examples/ is its own Alire crate (i18n_examples)
examples/bin/
examples/obj/
examples/config/
examples/alire/

# benchmarks/ is its own Alire crate (i18n_benchmarks)
benchmarks/bin/
benchmarks/obj/
benchmarks/config/
benchmarks/alire/

# CLDR tool executables emitted by cldr/cldr_tools.gpr and cldr/cldr_download.gpr
cldr/bin/
cldr/obj/
cldr/obj-download/
cldr/config/

# check_i18n generated output
check_i18n/bin/
check_i18n/obj/
check_i18n/config/
check_i18n/alire/

# Alire regenerates config/ on every build, including builds of crates that pin
# i18n as a path dependency — tracking it means their builds dirty this repo.
/config/

# Vendored upstream CLDR-JSON and large generated data/artifacts: kept local,
# regenerated from upstream, not committed (they bloat the repo by ~1GB+).
/cldr/upstream/
#  ... except the provenance, which is what makes the staged export
#  reproducible: it names the CLDR release the data was built from. Without it
#  a clone has the generated table but no way to tell what produced it.
!/cldr/upstream/source_manifest.txt
/cldr/data/cldr_subset.txt
/cldr/import/normalized_cldr.txt
/cldr/raw/cldr_records.txt
/conformance/bin/
/conformance/obj/
/conformance/config/
/conformance/alire/

#  Generated by cldr/src/generate_cldr_data.adb from cldr/data/cldr_subset.txt.
#  Build artifacts, not sources: regenerate them, do not version them. The
#  hand-written spec src/i18n-cldr_data.ads stays tracked.
/src/i18n-cldr_data.adb
/src/i18n-cldr_data-unit_display_name.adb
/src/i18n-cldr_data-currency_display_name.adb

#  Runtime data files for the display-name / measurement / delimiter areas,
#  generated by cldr/src/generate_cldr_display_data.adb from vendored upstream.
#  Loaded at run time by I18n.Data_Store; regenerated, not versioned.
/share/i18n/*.i18ndata
/share/i18n/collation/
/share/i18n/transforms/
/share/i18n/annotations/
/share/i18n/annotations-derived/
/share/i18n/calendars/
/share/i18n/units/
/share/i18n/zones/
/share/i18n/person-names/
/share/i18n/rbnf/
