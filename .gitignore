# GNAT/GPRbuild output
obj/
lib/
tests/bin/
/*.ali
/*.o

# Alire/local tool state
alire/
.alire/

# Example executables emitted by examples/examples.gpr
examples/bin/

# Benchmark executables emitted by benchmarks/benchmarks.gpr
benchmarks/bin/
benchmarks/obj/

# CLDR tool executables emitted by cldr/cldr_tools.gpr
cldr/bin/
cldr/obj/

# check_i18n generated output
check_i18n/bin/
check_i18n/obj/
check_i18n/config/

# Alire regenerates config/ on every build, including builds of crates that pin
# i18n as a path dependency — tracking it means their builds dirty this repo.
/config/

# Vendored upstream CLDR-JSON and large generated data/artifacts: kept local,
# regenerated from upstream, not committed (they bloat the repo by ~1GB+).
/cldr/upstream/
/src/i18n-cldr_data.adb
/cldr/data/cldr_subset.txt
/cldr/import/normalized_cldr.txt
/cldr/raw/cldr_records.txt
/conformance/bin/
/conformance/obj/
