with "config/cldr_tools_config.gpr";

project CLDR_Tools is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & Cldr_Tools_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use
     ("check_cldr_sources.adb",
      "check_tzdb_sources.adb",
      "download_tzdb.adb",
      "generate_cldr_export.adb",
      "import_cldr_raw.adb",
      "extract_cldr_normalized.adb",
      "generate_cldr_data.adb",
      "generate_cldr_display_data.adb",
      "generate_cldr_annotation_data.adb",
      "generate_cldr_calendar_data.adb",
      "generate_cldr_personname_data.adb",
      "generate_cldr_rbnf_data.adb",
      "generate_ucd_normalization_data.adb",
      "generate_ucd_segmentation_data.adb",
      "generate_uca_collation_data.adb",
      "generate_cldr_collation_tailoring.adb",
      "generate_ucd_uprops_data.adb",
      "generate_cldr_transform_data.adb",
      "import_cldr_subset.adb");

   package Compiler is
      --  -gnatWb overrides the -gnatW8 that Ada_Compiler_Switches brings in, and
      --  must stay last: the final -gnatW wins. The main unit's encoding method
      --  sets the run-time default for Text_IO output, and every one of these
      --  tools writes CLDR data that is *already* UTF-8 bytes in a String. Under
      --  -gnatW8 each of those bytes is encoded a second time -- U+00A0 comes out
      --  as "Â " and the staged export grows by ~4.9 MB of mojibake.
      for Default_Switches ("Ada") use
        Cldr_Tools_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata", "-gnatWb");
   end Compiler;


   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- an accented path, an internationalized
   --  domain name, a translated message -- came out doubled. -Wb is the
   --  compiler default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb"); --  Symbolic traceback
   end Binder;

   package Linker is
      --  download_tzdb links httpclient, whose TLS is `ssllib` and whose
      --  cache crypto is CryptoLib -- both Ada, so there is no C TLS library
      --  to link here any more.
      case Cldr_Tools_Config.Alire_Host_OS is
         when "windows" =>
            for Default_Switches ("Ada") use ("-lws2_32", "-lcrypt32");
         when others =>
            for Default_Switches ("Ada") use ();
      end case;
   end Linker;
end CLDR_Tools;
