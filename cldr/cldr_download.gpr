--  The network tools are a project of their own, not more Mains in
--  cldr_tools.gpr: they are the only CLDR tools that need an HTTP stack and a
--  ZIP decoder, and linking a TLS stack into the six generator/checker tools that
--  never touch the network would make every regeneration pay for a step that
--  runs once. Dependencies arrive through the generated config project, so the
--  two projects differ in nothing but their Mains and their Linker package.

with "config/cldr_tools_config.gpr";

project CLDR_Download is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj-download/" & Cldr_Tools_Config.Build_Profile;
   --  Not shared with cldr_tools.gpr's obj/: two projects in one crate cannot
   --  write to the same object directory.
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("download_cldr_upstream.adb", "fetch_ucd.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Cldr_Tools_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata");
   end Compiler;


   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- an accented path, an internationalized
   --  domain name, a translated message -- came out doubled. -Wb is the
   --  compiler default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb"); --  Symbolic traceback
   end Binder;

   package Linker is
      --  Nothing to link for TLS any more: httpclient's TLS is `ssllib` and
      --  its cache crypto is CryptoLib, both Ada. What is left is the Windows
      --  socket and certificate-store libraries, which the runtime wants there
      --  and libc provides elsewhere.
      case Cldr_Tools_Config.Alire_Host_OS is
         when "windows" =>
            --  Unverified: no Windows host has built this yet.
            for Default_Switches ("Ada") use ("-lws2_32", "-lcrypt32");
         when others =>
            for Default_Switches ("Ada") use ();
      end case;
   end Linker;
end CLDR_Download;
