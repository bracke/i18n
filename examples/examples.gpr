with "config/i18n_examples_config.gpr";

project Examples is
   for Source_Dirs use (".", "config");
   for Main use
     ("hello_world.adb",
      "basic_render.adb",
      "plural_render.adb",
      "select_render.adb",
      "selectordinal_render.adb",
      "nested_message_render.adb",
      "number_formatting.adb",
      "currency_formatting.adb",
      "date_formatting.adb",
      "time_formatting.adb",
      "domain_formatting.adb",
      "locale_fallback.adb",
      "fallback_chain.adb",
      "missing_key.adb",
      "missing_argument.adb",
      "invalid_argument.adb",
      "invalid_catalog.adb",
      "invalid_catalog_fields.adb",
      "diagnostics_non_interference.adb",
      "equals_in_value.adb",
      "reuse_runtime.adb",
      "status_handling.adb",
      "diagnostics_inspection.adb",
      "default_locale_key.adb",
      "empty_message.adb",
      "argument_lifecycle.adb",
      "public_api_example.adb",
      "public_api_sealed.adb");
   for Object_Dir use "obj/" & I18n_Examples_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";

   package Compiler is
      --  -gnatWb overrides the -gnatW8 that Ada_Compiler_Switches brings in.
      --  The encoding method of the main unit sets the runtime's default
      --  encoding for the standard output file: under -gnatW8 every byte of an
      --  already-UTF-8 String is encoded a second time, so the per-mille sign
      --  reaches the terminal as double-encoded mojibake and the outputs in
      --  examples/EXPECTED_OUTPUT.md no longer match. These sources are pure
      --  ASCII, so restoring GNAT's default brackets encoding changes nothing
      --  else. Keep this switch last -- the final -gnatW wins.
      for Default_Switches ("Ada") use
        I18n_Examples_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata", "-gnatwe", "-gnatWb");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;
end Examples;
