# ICU Messages Ada v1.1.0 example catalog.
# The canonical v1.1.0 format is one entry per line:
# locale.key = ICU message string

default_locale = en

en.hello = "Hello, {name}!"
en.cart.items = "{count, plural, one {One item} other {# items}}"
en.pet.label = "{animal, select, male {Tomcat} female {Queen cat} other {Unknown pet}}"
en.rank.label = "{rank, selectordinal, one {#st place} two {#nd place} few {#rd place} other {#th place}}"
it.rank.label = "{rank, selectordinal, many {#o posto speciale} other {#o posto}}"
en.upload.summary = "{gender, select, female {{name} uploaded {count, plural, one {one file} other {# files}}} male {{name} uploaded {count, plural, one {one file} other {# files}}} other {{name} uploaded {count, plural, one {one file} other {# files}}}}"
en.number.total = "Number: {value, number}"
en.number.percent = "Percent: {value, number, ::percent precision-integer}"
en.number.permille = "Permille: {value, number, ::permille}"
en.number.compact = "Compact: {value, number, ::compact-short precision-fraction/0-1}"
en.number.scientific = "Scientific: {value, number, ::scientific}"
en.number.engineering = "Engineering: {value, number, ::engineering}"
en.number.accounting = "Accounting number: {value, number, ::sign-accounting}"
en.number.scale = "Scaled: {value, number, ::scale/1000}"
en.number.trailing = "Trailing stripped: {value, number, ::precision-fraction/2 trailing-zero-display/stripIfInteger}"
en.number.spellout = "Spellout: {value, number, ::spellout}"
ar.number.total = "Arabic digits: {value, number}"
hi-IN.number.total = "Indian grouping: {value, number}"
en.currency.total = "Total: {amount, currency, USD}"
en.currency.name = "Name: {amount, currency, USD/name}"
en.currency.narrow = "Narrow: {amount, currency, CAD/narrow}"
en.currency.iso = "ISO: {amount, currency, USD/unit-width-iso-code}"
en.currency.cash = "Cash: {amount, currency, CHF/cash}"
en.currency.accounting = "Accounting: {amount, currency, USD/accounting}"
en.currency.yen = "Yen: {amount, currency, JPY}"
en.date.long = "Date: {day, date, long}"
en.date.skeleton = "Date skeleton: {day, date, ::yMMMd}"
en.date.numeric_skeleton = "Numeric skeleton: {day, date, ::yyyyMMdd}"
en.date.week_year = "Locale week fields: {day, date, ::Y'/'w'/'W'/'yyyy}"
ja-u-ca-japanese.date.japanese = "Japanese calendar: {day, date, long}"
th-u-ca-buddhist.date.buddhist = "Buddhist calendar: {day, date, long}"
en-u-ca-persian.date.persian = "Persian calendar: {day, date, ::GyyyyMMdd}"
en.time.short = "Time: {clock, time, short}"
en.time.long = "Time with seconds: {clock, time, long}"
en.time.skeleton = "Time skeleton: {clock, time, ::hhmmssa}"
en.time.fraction = "Fractional time: {clock, time, ::HHmmssSSS}"
en.time.zone = "Zoned time: {instant, time, ::HHmmz, America/New_York}"
en.time.zone_widths = "Zone widths: {instant, datetime, ::OOOO'|'ZZZZZ'|'xxxxx'|'VV, America/New_York}"
en.time.utc_widths = "UTC widths: {instant, datetime, ::ZZZZZ'|'xxxxx'|'VV, UTC}"
en.time.datetime_long = "Long datetime: {instant, datetime, ::long, America/New_York}"
en.time.datetime_full = "Full datetime: {instant, datetime, ::full, America/New_York}"
en.domain.duration = "Duration: {seconds, duration}"
en.domain.bytes = "Size: {size, bytes}"
en.domain.unit = "Distance: {distance, unit, kilometer}"
en.domain.rate = "Rate: {distance, number, ::measure-unit/length-kilometer per-measure-unit/duration-hour}"
en.domain.short_rate = "Short rate: {distance, number, ::measure-unit/length-kilometer unit-width-short per-measure-unit/duration-hour}"
en.domain.relative = "When: {offset, relative, day}"
en.domain.list = "List: {items, list}"
en.equals.demo = "A value may contain = after the first separator."
en.fallback.only = "Default fallback text for {name}."

en.empty.message = ""
plain = "Unqualified default-locale text for {name}."

de.hello = "Hallo, {name}!"
de.cart.items = "{count, plural, one {Ein Artikel} other {# Artikel}}"
de.pet.label = "{animal, select, male {Kater} female {Katze} other {Unbekanntes Tier}}"
de.number.total = "Zahl: {value, number}"
de.currency.total = "Summe: {amount, currency, EUR}"
de.date.full = "Datum: {day, date, full}"
de.domain.relative = "Wann: {offset, relative, day}"
de.domain.list = "Liste: {items, list}"

de-AT.hello = "Servus, {name}!"
