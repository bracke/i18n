# ICU Messages Ada v1.0 example catalog.
# The canonical v1.0 format is one entry per line:
# locale.key = ICU message string

default_locale = en

en.hello = "Hello, {name}!"
en.cart.items = "{count, plural, one {One item} other {# items}}"
en.pet.label = "{animal, select, male {Tomcat} female {Queen cat} other {Unknown pet}}"
en.rank.label = "{rank, selectordinal, one {#st place} two {#nd place} few {#rd place} other {#th place}}"
en.upload.summary = "{gender, select, female {{name} uploaded {count, plural, one {one file} other {# files}}} male {{name} uploaded {count, plural, one {one file} other {# files}}} other {{name} uploaded {count, plural, one {one file} other {# files}}}}"
en.equals.demo = "A value may contain = after the first separator."
en.fallback.only = "Default fallback text for {name}."

en.empty.message = ""
plain.default = "Unqualified default-locale text for {name}."

de.hello = "Hallo, {name}!"
de.cart.items = "{count, plural, one {Ein Artikel} other {# Artikel}}"
de.pet.label = "{animal, select, male {Kater} female {Katze} other {Unbekanntes Tier}}"

de-AT.hello = "Servus, {name}!"
