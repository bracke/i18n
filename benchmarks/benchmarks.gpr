with "../i18n.gpr";

project Benchmarks is
   for Source_Dirs use (".");
   for Main use ("render_benchmarks.adb");
   for Object_Dir use "../obj/benchmarks";
   for Exec_Dir use "bin";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022",
         "-gnata",
         "-gnatwa",
         "-gnatwe");
   end Compiler;
end Benchmarks;
