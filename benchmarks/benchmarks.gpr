with "config/i18n_benchmarks_config.gpr";

project Benchmarks is
   for Source_Dirs use (".", "config");
   for Main use ("render_benchmarks.adb");
   for Object_Dir use "obj/" & I18n_Benchmarks_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";

   package Compiler is
      for Default_Switches ("Ada") use
        I18n_Benchmarks_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata", "-gnatwe");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;
end Benchmarks;
