with "config/i18n_conformance_config.gpr";

project Conformance is
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & I18n_Conformance_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("check_conformance.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        I18n_Conformance_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;
end Conformance;
