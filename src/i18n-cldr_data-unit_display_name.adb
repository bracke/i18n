      --  " " is not a code, so an unknown base matches nothing --
      --  which is what comparing an unknown name did before.
      function Base_Code return String is
         Low : Natural := 1;
         High : Natural := Base_Count;
         Mid : Natural;
         Wanted : constant String :=
           (if Base'Length >= 33 then Base (Base'First .. Base'First + 32)
            else Base & (1 .. 33 - Base'Length => ' '));
      begin
         while Low <= High loop
            Mid := (Low + High) / 2;
            declare
               At_Key : constant Natural :=
                 Base_Index'First + (Mid - 1) * Base_Width;
               Key : constant String :=
                 Base_Index (At_Key .. At_Key + 32);
            begin
               if Key = Wanted then
                  return Base_Index (At_Key + 33 .. At_Key + 34);
               elsif Key < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end;
