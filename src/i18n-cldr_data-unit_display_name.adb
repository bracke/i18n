      Base_Width : constant := 35;
      Base_Count : constant Natural :=
        Base_Index'Length / Base_Width;

      --  " " is not a code, so an unknown base matches nothing --
      --  which is what comparing an unknown name did before.
      function Base_Code return String is
         Low : Natural := 1;
         High : Natural := Base_Count;
         Mid : Natural;
         Wanted : constant String :=
           (if Base'Length >= 33 then Base (Base'First .. Base'First + 32)
            else Base & (1 .. 33 - Base'Length => ' '));
      begin
         while Low <= High loop
            Mid := (Low + High) / 2;
            declare
               At_Key : constant Natural :=
                 Base_Index'First + (Mid - 1) * Base_Width;
               Key : constant String :=
                 Base_Index (At_Key .. At_Key + 32);
            begin
               if Key = Wanted then
                  return Base_Index (At_Key + 33 .. At_Key + 34);
               elsif Key < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end;
         end loop;

         return "  ";
      end Base_Code;

      function Width_Code return String is
        (if Width = "unit-width-full-name" then "f"
         elsif Width = "unit-width-short" then "s"
         elsif Width = "unit-width-narrow" then "n"
         else " ");

      function Category_Code (Want : String) return String is
        (if Want = "other" then "o"
         elsif Want = "one" then "1"
         elsif Want = "zero" then "z"
         elsif Want = "two" then "2"
         elsif Want = "few" then "w"
         elsif Want = "many" then "m"
         else " ");

      Wanted_Base : constant String := Base_Code;
      Wanted_Width : constant String := Width_Code;

      function Extended_Unit_Name return String is
      begin
         return "";
      end Extended_Unit_Name;

      --  Records are a four-character key -- two for the base,
      --  one for the width, one for the category -- then the hex.
      --  The labels themselves were four fifths of this table.
      function Search (Rows : String; Want : String) return String is
         Start : Positive := Rows'First;
         Key : constant String :=
           Wanted_Base & Wanted_Width & Category_Code (Want);
      begin
         if Key (Key'First) = ' ' or else Key (Key'Last) = ' ' then
            return "";
         end if;

         while Start <= Rows'Last loop
            declare
               Stop : Natural := Rows'Last + 1;
            begin
               for Index in Start .. Rows'Last loop
                  if Rows (Index) = '~' then
                     Stop := Index;
                     exit;
                  end if;
               end loop;

               if Stop > Start + 4
                 and then Rows (Start .. Start + 3) = Key
               then
                  return HB (Rows (Start + 4 .. Stop - 1));
               end if;

               Start := Stop + 1;
            end;
         end loop;

         return "";
      end Search;

      function Category_Row (Want : String) return String is
         Exact : constant String :=
           Search (Unit_Name_Row (Locale), Want);
         Canon : constant String := Canonical_Locale (Locale);
         Cut : Natural := Canon'Last;
      begin
         if Exact /= "" then
            return Exact;
         end if;

         --  Then each parent, longest first.
         while Cut > Canon'First loop
            if Canon (Cut) = '-' then
               declare
                  Hit : constant String :=
                    Search
                      (Unit_Name_Row (Canon (Canon'First .. Cut - 1)),
                       Want);
               begin
                  if Hit /= "" then
                     return Hit;
                  end if;
               end;
            end if;
            Cut := Cut - 1;
         end loop;

         return "";
      end Category_Row;

      --  Root (und) rows carry the CLDR abbreviated forms used by any
      --  locale that supplies no data of its own. They are the final
      --  resort before the built-in English defaults, and only the
      --  abbreviated (short/narrow) widths consult them -- full names
      --  keep falling through to the English word forms.
      --
      --  root before und, the order the records were in.
      function Root_Category_Row (Want : String) return String is
         Rooted : constant String := Search (Unit_Name_Row ("root"), Want);
      begin
         if Rooted /= "" then
            return Rooted;
         end if;
         return Search (Unit_Name_Row ("und"), Want);
      end Root_Category_Row;

      function Root_Row return String is
         Primary : constant String := Root_Category_Row (Category);
      begin
         if Primary /= "" then
            return Primary;
         end if;
         if Category /= "other" then
            declare
               Other_Row : constant String :=
                 Root_Category_Row ("other");
            begin
               if Other_Row /= "" then
                  return Other_Row;
               end if;
            end;
         end if;
         if Category /= "one" then
            return Root_Category_Row ("one");
         end if;
         return "";
      end Root_Row;

      function Localized_Row return String is
         Primary : constant String := Category_Row (Category);
