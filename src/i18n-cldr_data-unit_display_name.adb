      function Search (Rows : String; Want : String) return String is
         Start : Positive := Rows'First;
      begin
         while Start <= Rows'Last loop
            declare
               Sep1 : Natural := 0;
               Sep2 : Natural := 0;
               Sep3 : Natural := 0;
               Stop : Natural := Rows'Last + 1;
            begin
               for Index in Start .. Rows'Last loop
                  if Rows (Index) = '|' then
                     if Sep1 = 0 then
                        Sep1 := Index;
                     elsif Sep2 = 0 then
                        Sep2 := Index;
                     elsif Sep3 = 0 then
                        Sep3 := Index;
                     end if;
                  elsif Rows (Index) = '~' then
                     Stop := Index;
                     exit;
                  end if;
               end loop;

               if Sep3 /= 0
                 and then Sep1 > Start
                 and then Sep2 > Sep1 + 1
                 and then Sep3 > Sep2 + 1
                 and then Stop > Sep3 + 1
                 and then Rows (Start .. Sep1 - 1) = Base
                 and then Rows (Sep1 + 1 .. Sep2 - 1) = Width
                 and then Rows (Sep2 + 1 .. Sep3 - 1) = Want
               then
                  return HB (Rows (Sep3 + 1 .. Stop - 1));
               end if;

               Start := Stop + 1;
            end;
         end loop;

         return "";
      end Search;

      function Category_Row (Want : String) return String is
         Exact : constant String :=
           Search (Unit_Name_Row (Locale), Want);
         Canon : constant String := Canonical_Locale (Locale);
         Cut : Natural := Canon'Last;
      begin
         if Exact /= "" then
            return Exact;
         end if;

         --  Then each parent, longest first.
         while Cut > Canon'First loop
            if Canon (Cut) = '-' then
               declare
                  Hit : constant String :=
                    Search
                      (Unit_Name_Row (Canon (Canon'First .. Cut - 1)),
                       Want);
               begin
                  if Hit /= "" then
                     return Hit;
                  end if;
               end;
            end if;
            Cut := Cut - 1;
         end loop;

         return "";
      end Category_Row;

      --  Root (und) rows carry the CLDR abbreviated forms used by any
      --  locale that supplies no data of its own. They are the final
      --  resort before the built-in English defaults, and only the
      --  abbreviated (short/narrow) widths consult them -- full names
      --  keep falling through to the English word forms.
      --
      --  root before und, the order the records were in.
      function Root_Category_Row (Want : String) return String is
         Rooted : constant String := Search (Unit_Name_Row ("root"), Want);
      begin
         if Rooted /= "" then
            return Rooted;
         end if;
         return Search (Unit_Name_Row ("und"), Want);
      end Root_Category_Row;

      function Root_Row return String is
         Primary : constant String := Root_Category_Row (Category);
      begin
         if Primary /= "" then
            return Primary;
         end if;
         if Category /= "other" then
            declare
               Other_Row : constant String :=
                 Root_Category_Row ("other");
            begin
               if Other_Row /= "" then
                  return Other_Row;
               end if;
            end;
         end if;
         if Category /= "one" then
            return Root_Category_Row ("one");
         end if;
         return "";
      end Root_Row;

