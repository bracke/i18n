      function Category_Code (Want : String) return String is
        (if Want = "other" then "o"
         elsif Want = "one" then "1"
         elsif Want = "zero" then "z"
         elsif Want = "two" then "2"
         elsif Want = "few" then "w"
         elsif Want = "many" then "m"
         else " ");

      Wanted_Base : constant String := Base_Code;
      Wanted_Width : constant String := Width_Code;

      function Extended_Unit_Name return String is
      begin
