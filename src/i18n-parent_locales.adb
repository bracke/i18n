   function Parent (Locale : String) return String is
      Lo : Positive := Table'First;
      Hi : Natural  := Table'Last;
   begin
      while Lo <= Hi loop
         declare
            Mid : constant Positive := (Lo + Hi) / 2;
            Key : constant String := To_String (Table (Mid).Child);
         begin
            if Locale = Key then
               return To_String (Table (Mid).Parent);
            elsif Locale < Key then
               Hi := Mid - 1;
            else
               Lo := Mid + 1;
            end if;
         end;
      end loop;
      return "";
   end Parent;

end I18N.Parent_Locales;
