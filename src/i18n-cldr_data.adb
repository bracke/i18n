      --  A couple of dozen skeletons: a scan costs less than the
      --  arithmetic to bisect them.
      for N in 1 .. Skeleton_Count loop
         declare
            Base : constant Natural :=
              Skeleton_Index'First + (N - 1) * Skeleton_Width;
            Name : constant String :=
              Skeleton_Index (Base .. Base + 7);
            Stop : Natural := Name'Last;
         begin
            while Stop >= Name'First and then Name (Stop) = ' ' loop
               Stop := Stop - 1;
            end loop;
            if Name (Name'First .. Stop) = Skeleton then
               Segment_First :=
                 Natural'Value
                   (Skeleton_Index (Base + 8 .. Base + 14));
               Segment_Last :=
                 Natural'Value
                   (Skeleton_Index (Base + 15 .. Base + 21));
               exit;
            end if;
         end;
