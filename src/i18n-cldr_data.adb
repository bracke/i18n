            return UTF8 ([16#62A#, 16#648#, 16#642#, 16#64A#,
              16#62A#, 16#20#, 16#639#, 16#627#, 16#645#]);
         end if;
      elsif Lang = "ja" then
         if Family = "europe-central" then
            return UTF8 ([16#4E2D#, 16#592E#, 16#30E8#,
              16#30FC#, 16#30ED#, 16#30C3#, 16#30D1#,
