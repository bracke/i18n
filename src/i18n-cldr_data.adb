      Width : constant := 30;
      Count : constant Natural := Index_Data'Length / Width;

      function Key (N : Positive) return String is
        (Index_Data (Index_Data'First + (N - 1) * Width ..
                     Index_Data'First + (N - 1) * Width + 13));

      function Padded (Cand : String) return String is
        (if Cand'Length >= 14 then Cand (Cand'First .. Cand'First + 13)
         else Cand & (1 .. 14 - Cand'Length => ' '));

      function Value_At (N : Positive) return String is
         Base : constant Natural :=
           Index_Data'First + (N - 1) * Width + 14;
         F : constant Natural :=
           Natural'Value (Index_Data (Base .. Base + 7));
         T : constant Natural :=
           Natural'Value (Index_Data (Base + 8 .. Base + 15));
      begin
         return Values (F .. T);
      end Value_At;

      --  Keys are stored canonical, so canonicalise once and
      --  bisect. Nothing walks: a locale the table does not hold
      --  costs the same handful of comparisons as one it does.
      function Lookup (Cand : String) return String is
         Low : Natural := 1;
         High : Natural := Count;
         Mid : Natural;
      begin
         if Cand'Length = 0 or else Count = 0 then
            return "";
         end if;

         declare
            Wanted : constant String :=
              Padded (Canonical_Locale (Cand));
         begin
            while Low <= High loop
               Mid := (Low + High) / 2;
               if Key (Mid) = Wanted then
                  return Value_At (Mid);
               elsif Key (Mid) < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end loop;
         end;
         return "";
      end Lookup;

      Exact : constant String := Lookup (Locale);
   begin
      if Exact /= "" then
         return Exact;
      end if;

      return "";
   end Relative_Unit_Row;

   function Relative_Unit_Payload_Value
     (Payload  : String;
      Base     : String;
      Category : String)
      return String
   is
      Start : Positive := Payload'First;
      Stop  : Natural;
      Last  : Natural;
      Sep_1 : Natural;
      Sep_2 : Natural;
   begin
      while Start <= Payload'Last loop
         Stop := Start;
         while Stop <= Payload'Last and then Payload (Stop) /= ';' loop
            Stop := Stop + 1;
         end loop;
         Last := Stop - 1;
         Sep_1 := 0;
         Sep_2 := 0;
         for Index in Start .. Last loop
            if Payload (Index) = ',' then
               if Sep_1 = 0 then
                  Sep_1 := Index;
               else
                  Sep_2 := Index;
                  exit;
               end if;
            end if;
         end loop;

         if Sep_1 > 0 and then Sep_2 > 0
           and then Payload (Start .. Sep_1 - 1) = Base
           and then Payload (Sep_1 + 1 .. Sep_2 - 1) = Category
         then
            return HB (Payload (Sep_2 + 1 .. Last));
         end if;
         Start := Stop + 1;
      end loop;

      return "";
   end Relative_Unit_Payload_Value;

   function Relative_Unit_Category_Name
     (Locale   : String;
      Base     : String;
      Category : String)
      return String
   is
      function Find (Cand : String; Wanted : String) return String is
         Row : constant String := Relative_Unit_Row (Cand);
      begin
         if Row = "" then
            return "";
         end if;
         return Relative_Unit_Payload_Value (Row, Base, Wanted);
      end Find;

      --  The locale, then each parent, longest first.
      function Resolve (Wanted : String) return String is
         Canon : constant String := Canonical_Locale (Locale);
         Exact : constant String := Find (Locale, Wanted);
         Cut : Natural := Canon'Last;
      begin
         if Exact /= "" then
            return Exact;
         end if;

         while Cut > Canon'First loop
            if Canon (Cut) = '-' then
               declare
                  Hit : constant String :=
                    Find (Canon (Canon'First .. Cut - 1), Wanted);
               begin
                  if Hit /= "" then
                     return Hit;
                  end if;
               end;
            end if;
            Cut := Cut - 1;
         end loop;

         return "";
      end Resolve;

      Wanted : constant String := Resolve (Category);
   begin
      if Wanted /= "" then
         return Wanted;
      end if;

      --  Only once no locale has the category does "other" answer,
      --  and an "other" row answers whatever category was asked.
      return Resolve ("other");
   end Relative_Unit_Category_Name;

