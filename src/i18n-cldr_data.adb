   function Day_Period_Payload_Value
     (Payload : String;
      Period  : String;
      Width   : String)
      return String
   is
      Start : Positive := Payload'First;
      Stop  : Natural;
      Last  : Natural;
      Sep_1 : Natural;
      Sep_2 : Natural;
   begin
      while Start <= Payload'Last loop
         Stop := Start;
         while Stop <= Payload'Last and then Payload (Stop) /= ';' loop
            Stop := Stop + 1;
         end loop;
         Last := Stop - 1;
         Sep_1 := 0;
         Sep_2 := 0;
         for Index in Start .. Last loop
            if Payload (Index) = ',' then
               if Sep_1 = 0 then
                  Sep_1 := Index;
               else
                  Sep_2 := Index;
                  exit;
               end if;
            end if;
         end loop;
         if Sep_1 > Start
           and then Sep_2 > Sep_1 + 1
           and then Payload (Start .. Sep_1 - 1) = Period
           and then Payload (Sep_1 + 1 .. Sep_2 - 1) = Width
         then
            return HB (Payload (Sep_2 + 1 .. Last));
         end if;
         Start := Stop + 1;
      end loop;
      return "";
   end Day_Period_Payload_Value;

