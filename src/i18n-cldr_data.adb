         Absent : constant String := [1 => Character'Val (0)];
         Row : constant String :=
           (if Future then Relative_Offset_Prefix_Future_Row (Locale)
            else Relative_Offset_Prefix_Past_Row (Locale));
      begin
         if Row /= Absent then
            return Row;
         end if;
      end;

      if Future then
         if Lang = "fr" then
            return "dans ";
         elsif Lang = "es" then
            return "dentro de ";
         elsif Lang = "it" then
            return "tra ";
         elsif Lang = "pt" then
            return "em ";
         elsif Lang = "nl" then
            return "over ";
         elsif Lang = "ro" then
            return "peste ";
         elsif Lang = "lt" then
            return "po ";
         elsif Lang = "sl" then
            return U (16#10D#) & "ez ";
         elsif Lang = "pl" or else Lang = "cs" then
            return "za ";
         elsif Lang = "ru" then
            return U (16#447#) & U (16#435#) & U (16#440#)
              & U (16#435#) & U (16#437#) & " ";
         elsif Lang = "ar" then
            return U (16#628#) & U (16#639#) & U (16#62F#) & " ";
         elsif Lang = "sv" or else Lang = "da" then
            return "om ";
         elsif Lang = "eo" then
            return "post ";
         elsif Lang = "vi" then
            return "trong ";
         elsif Lang = "sk" then
            return "o ";
         elsif Lang = "no" then
            return "om ";
         elsif Lang = "id" or else Lang = "ms" then
            return "dalam ";
         elsif Lang = "af" then
            return "oor ";
         elsif Lang = "sw" then
            return "baada ya ";
         elsif Lang = "fi" or else Lang = "eu" then
            return "";
         elsif Lang = "tr" or else Lang = "hu" then
            return "";
         elsif Lang = "ja" or else Lang = "zh" or else Lang = "ko" then
            return "";
         else
            return "in ";
         end if;
      elsif Lang = "pt" then
         return "h" & U (16#E1#) & " ";
      elsif Lang = "de" then
         return "vor ";
      elsif Lang = "fr" then
         return "il y a ";
      elsif Lang = "es" then
         return "hace ";
      elsif Lang = "ro" then
         return "acum ";
      elsif Lang = "lt" then
         return "prie" & U (16#161#) & " ";
      elsif Lang = "sl" then
         return "pred ";
      elsif Lang = "cs" then
         return "p" & U (16#159#) & "ed ";
      elsif Lang = "ar" then
         return U (16#642#) & U (16#628#) & U (16#644#) & " ";
      elsif Lang = "sv" then
         return UTF8 ([16#66#, 16#F6#, 16#72#, 16#20#]);
      elsif Lang = "da" then
         return "for ";
      elsif Lang = "eo" then
         return UTF8 ([16#61#, 16#6E#, 16#74#, 16#61#, 16#16D#, 16#20#]);
      elsif Lang = "sk" then
         return "pred ";
      elsif Lang = "no" then
         return "for ";
      elsif Lang = "eu" then
         return "duela ";
      else
         return "";
      end if;
   end Relative_Offset_Prefix;

