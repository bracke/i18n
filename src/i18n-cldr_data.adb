         --  Digit_Row is decoded by its own Value_At, so Row is
         --  already the forty bytes: ten digits of four.
         if Row'Length = 40 and then Digit in '0' .. '9' then
            declare
               Base : constant Natural :=
                 Row'First
                   + (Character'Pos (Digit)
                      - Character'Pos ('0')) * 4;
               Stop : Natural := Base + 3;
            begin
               while Stop >= Base
                 and then Row (Stop) = Character'Val (0)
               loop
                  Stop := Stop - 1;
               end loop;
               return Row (Base .. Stop);
            end;
         end if;

         return [1 => Digit];
      end;
   end Digit_Text;

