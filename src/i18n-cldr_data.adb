   function First_Day_Of_Week (Locale : String) return String is
   begin
      if Locale_In_List
        (Locale => Locale,
         List =>
           "en-001,en-AU,en-GB,en-IE,en-IN,en-NZ,de,fr,es,it,nl,"
           & "pl,pt,ru,ro,lt,sl,cs,da,sv,nb,nn,fi,tr,vi,uk,bg,"
           & "el,hu,sk,ca,eu,af,sw,eo",
         Include_Fallback => True)
      then
         return "mon";
      elsif Locale_In_List
        (Locale => Locale,
         List =>
           "ar-AE,ar-BH,ar-DJ,ar-DZ,ar-EG,ar-IQ,ar-JO,ar-KW,"
           & "ar-LY,ar-OM,ar-QA,ar-SD,ar-SY,ar-YE,fa-AF,fa-IR,"
           & "he-IL",
         Include_Fallback => True)
      then
         return "sat";
      elsif Locale_In_List
        (Locale => Locale,
         List => "ar-MV",
         Include_Fallback => True)
      then
         return "fri";
      else
         return "sun";
      end if;
   end First_Day_Of_Week;

   function First_Week_Min_Days (Locale : String) return Natural is
   begin
      if Locale_In_List
        (Locale => Locale,
         List =>
           "en-001,en-AU,en-GB,en-IE,en-IN,en-NZ,de,fr,es,it,nl,"
           & "pl,pt,ru,ro,lt,sl,cs,da,sv,nb,nn,fi,tr,vi,uk,bg,"
           & "el,hu,sk,ca,eu,af,sw,eo",
         Include_Fallback => True)
      then
         return 4;
      else
         return 1;
      end if;
   end First_Week_Min_Days;

   function Time_Style_Pattern
     (Locale     : String;
      Style      : String;
      Has_Second : Boolean)
      return String
   is
      Lang : constant String := Language (Locale);
   begin
      if Lang = "ko" then
         if Style = "long" or else Style = "full" then
            return "ah':'mm':'ss";
         elsif Style = "" or else Style = "medium" then
            return (if Has_Second then "ah':'mm':'ss" else "ah':'mm");
         else
            return "ah':'mm";
         end if;
      elsif Style = "long" or else Style = "full" then
         return "HH':'mm':'ss";
      elsif Style = "" or else Style = "medium" then
         return (if Has_Second then "HH':'mm':'ss" else "HH':'mm");
      else
         return "HH':'mm";
      end if;
   end Time_Style_Pattern;

   function Date_Time_Field_Separator
     (Locale     : String;
      Last_Class : Character;
      Class      : Character;
      Last_Field : Character;
      Field      : Character)
      return String
   is
      pragma Unreferenced (Locale);
   begin
      if Last_Class = 'D' and then Class = 'T' then
         return " ";
      elsif Class = 'T' and then Last_Class = 'T' then
         if Field = 'S' then
            return ".";
         elsif Last_Field in 'a' | 'b' | 'B' | 'z' | 'Z' | 'O'
             | 'v' | 'V' | 'X' | 'x' | 'S' | 'A'
           or else Field in 'a' | 'b' | 'B' | 'z' | 'Z' | 'O'
             | 'v' | 'V' | 'X' | 'x' | 'A'
         then
            return " ";
         else
            return ":";
         end if;
      else
         return " ";
      end if;
   end Date_Time_Field_Separator;

   function Date_Time_Style_Separator (Locale : String) return String is
      pragma Unreferenced (Locale);
   begin
      return " ";
   end Date_Time_Style_Separator;

   function Digit_Row (Locale : String) return String is
      Values : constant String :=
        "";
      Index_Data : constant String :=
        "ar            aaaabaaaa2ar-bh         aaaabaaaa2ar-dj         aaaabaaaa2ar-eg         aaaabaaaa2ar-er         aaaabaaaa2ar-il         aaaabaaaa2ar-iq         aaaabaaaa2ar-jo         aaaabaaaa2ar-km         aaaabaaaa2ar-kw         aaaabaaaa2ar-lb         aaaabaaaa2ar-mr         aaaabaaaa2ar-om         aaaabaaaa2ar-ps         aaaabaaaa2ar-qa         aaaabaaaa2ar-sa         aaaabaaaa2ar-sd         aaaabaaaa2ar-so         aaaabaaaa2ar-ss         aaaabaaaa2ar-sy         aaaabaaaa2ar-td         aaaabaaaa2ar-ye         aaaabaaaa2as            aaaa3aaabUaz-arab       aaabVaaacMaz-arab-iq    aaabVaaacMaz-arab-tr    aaabVaaacMbgc           aaacNaaadEbgn           aaabVaaacMbgn-ae        aaabVaaacMbgn-af        aaabVaaacMbgn-ir        aaabVaaacMbgn-om        aaabVaaacMbho           aaacNaaadEbn            aaaa3aaabUbn-in         aaaa3aaabUccp           aaadFaaaewccp-in        aaadFaaaewckb           aaaabaaaa2ckb-ir        aaaabaaaa2dz            aaaexaaafofa            aaabVaaacMfa-af         aaabVaaacMff-adlm       aaafpaaaggff-adlm-bf    aaafpaaaggff-adlm-cm    aaafpaaaggff-adlm-gh    aaafpaaaggff-adlm-gm    aaafpaaaggff-adlm-gw    aaafpaaaggff-adlm-lr    aaafpaaaggff-adlm-mr    aaafpaaaggff-adlm-ne    aaafpaaaggff-adlm-ng    aaafpaaaggff-adlm-sl    aaafpaaaggff-adlm-sn    aaafpaaagghnj           aaaghaaag8hnj-hmnp      aaaghaaag8ks            aaabVaaacMks-arab       aaabVaaacMlrc           aaabVaaacMlrc-iq        aaabVaaacMmni           aaaa3aaabUmni-beng      aaaa3aaabUmni-mtei      aaag9aaah0mr            aaacNaaadEmww           aaaghaaag8mww-hmnp      aaaghaaag8my            aaah1aaaiSmzn           aaabVaaacMne            aaacNaaadEne-in         aaacNaaadEnqo           aaaiTaaajKpa-arab       aaabVaaacMps            aaabVaaacMps-pk         aaabVaaacMraj           aaacNaaadEsa            aaacNaaadEsat           aaajLaaakCsat-deva      aaacNaaadEsat-olck      aaajLaaakCsd            aaaabaaaa2sd-arab       aaaabaaaa2sdh           aaaabaaaa2sdh-iq        aaaabaaaa2th            aaakDaaaluur-in         aaabVaaacMuz-arab       aaabVaaacM";
      Width : constant := 24;
      Count : constant Natural := Index_Data'Length / Width;

      function Key (N : Positive) return String is
        (Index_Data (Index_Data'First + (N - 1) * Width ..
                     Index_Data'First + (N - 1) * Width + 13));

      function Padded (Cand : String) return String is
        (if Cand'Length >= 14 then Cand (Cand'First .. Cand'First + 13)
         else Cand & [1 .. 14 - Cand'Length => ' ']);

      function Value_At (N : Positive) return String is
         Base : constant Natural :=
           Index_Data'First + (N - 1) * Width + 14;
         F : constant Natural :=
           N62 (Index_Data (Base .. Base + 4));
         T : constant Natural :=
           N62 (Index_Data (Base + 5 .. Base + 9));
      begin
         return VB (Values (F .. T));
      end Value_At;

      --  Keys are stored canonical, so canonicalise once and
      --  bisect. Nothing walks: a locale the table does not hold
      --  costs the same handful of comparisons as one it does.
      function Lookup (Cand : String) return String is
         Low : Natural := 1;
         High : Natural := Count;
         Mid : Natural;
      begin
         if Cand'Length = 0 then
            return "";
         end if;

         declare
            Wanted : constant String :=
              Padded (Canonical_Locale (Cand));
         begin
            while Low <= High loop
               Mid := (Low + High) / 2;
               if Key (Mid) = Wanted then
                  return Value_At (Mid);
               elsif Key (Mid) < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end loop;
         end;
         return "";
      end Lookup;

      --  Parents are cut from the canonical spelling: "de_AT" has
      --  no '-' to cut, and would otherwise lose its fallback.
      Canon : constant String := Canonical_Locale (Locale);
      Exact : constant String := Lookup (Locale);
      Cut : Natural := Canon'Last;
   begin
      if Exact /= "" then
         return Exact;
      end if;

      --  Then each parent, which is what the fallback pass did.
      while Cut > Canon'First loop
         if Canon (Cut) = '-' then
            declare
               Hit : constant String :=
                 Lookup (Canon (Canon'First .. Cut - 1));
            begin
               if Hit /= "" then
                  return Hit;
               end if;
            end;
         end if;
         Cut := Cut - 1;
      end loop;

      return "";
   end Digit_Row;

   function Digit_Text (Locale : String; Digit : Character) return String is
      Lang : constant String := Language (Locale);
   begin
      --  A locale either carries a numbering-system override or it
      --  does not. Testing that once skips the whole chain for the
      --  locales that do not, which is nearly all of them, and
      --  Digit_Text is asked once per digit of every number.
      if Contains (Locale, "-u-nu-")
        or else Contains (Locale, "@numbers=")
      then
         if Contains (Locale, "-u-nu-latn")
           or else Contains (Locale, "@numbers=latn")
         then
            return [1 => Digit];
         elsif Contains (Locale, "-u-nu-fullwide")
           or else Contains (Locale, "@numbers=fullwide")
         then
         case Digit is
            when '0' => return U (16#FF10#);
            when '1' => return U (16#FF11#);
            when '2' => return U (16#FF12#);
            when '3' => return U (16#FF13#);
            when '4' => return U (16#FF14#);
            when '5' => return U (16#FF15#);
            when '6' => return U (16#FF16#);
            when '7' => return U (16#FF17#);
            when '8' => return U (16#FF18#);
            when '9' => return U (16#FF19#);
            when others => return [1 => Digit];
         end case;
         elsif Contains (Locale, "-u-nu-lanatham")
           or else Contains (Locale, "@numbers=lanatham")
         then
         case Digit is
            when '0' => return U (16#1A90#);
            when '1' => return U (16#1A91#);
            when '2' => return U (16#1A92#);
            when '3' => return U (16#1A93#);
            when '4' => return U (16#1A94#);
            when '5' => return U (16#1A95#);
            when '6' => return U (16#1A96#);
            when '7' => return U (16#1A97#);
            when '8' => return U (16#1A98#);
            when '9' => return U (16#1A99#);
            when others => return [1 => Digit];
         end case;
         elsif Contains (Locale, "-u-nu-mathbold")
           or else Contains (Locale, "@numbers=mathbold")
         then
         case Digit is
            when '0' => return U (16#1D7CE#);
            when '1' => return U (16#1D7CF#);
            when '2' => return U (16#1D7D0#);
            when '3' => return U (16#1D7D1#);
            when '4' => return U (16#1D7D2#);
            when '5' => return U (16#1D7D3#);
            when '6' => return U (16#1D7D4#);
            when '7' => return U (16#1D7D5#);
            when '8' => return U (16#1D7D6#);
            when '9' => return U (16#1D7D7#);
            when others => return [1 => Digit];
         end case;
         elsif Contains (Locale, "-u-nu-mathmono")
           or else Contains (Locale, "@numbers=mathmono")
         then
         case Digit is
            when '0' => return U (16#1D7F6#);
            when '1' => return U (16#1D7F7#);
