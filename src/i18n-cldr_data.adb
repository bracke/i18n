        or else Zone = "Australia/Melbourne"
        or else Zone = "Australia/Hobart"
      then
         return "australia-eastern";
      elsif Zone = "Australia/Adelaide" then
         return "australia-central";
      elsif Zone = "Australia/Brisbane" then
         return "australia-eastern";
      elsif Zone = "Australia/Darwin" then
         return "australia-central";
      elsif Zone = "Australia/Eucla" then
         return "australia-central-western";
      elsif Zone = "Australia/Perth" then
         return "australia-western";
      elsif Zone = "Australia/Lord_Howe" then
         return "australia-lord-howe";
      elsif Zone = "Asia/Jerusalem" then
         return "asia-jerusalem";
      elsif Zone = "Asia/Tehran" then
         return "asia-tehran";
      else
         return "none";
      end if;
   end Time_Zone_DST_Family;


