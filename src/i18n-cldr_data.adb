               elsif Key (Mid) < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end loop;
         end;
         return "";
      end Lookup;
   begin
      --  A couple of dozen skeletons: a scan costs less than the
      --  arithmetic to bisect them.
      for N in 1 .. Skeleton_Count loop
         declare
            Base : constant Natural :=
              Skeleton_Index'First + (N - 1) * Skeleton_Width;
            Name : constant String :=
              Skeleton_Index (Base .. Base + 7);
            Stop : Natural := Name'Last;
         begin
            while Stop >= Name'First and then Name (Stop) = ' ' loop
               Stop := Stop - 1;
            end loop;
            if Name (Name'First .. Stop) = Skeleton then
               Segment_First :=
                 Natural'Value
                   (Skeleton_Index (Base + 8 .. Base + 14));
               Segment_Last :=
                 Natural'Value
                   (Skeleton_Index (Base + 15 .. Base + 21));
               exit;
            end if;
         end;
      end loop;

      if Segment_First = 0 then
         return "";
      end if;

      declare
         Exact : constant String := Lookup (Locale);
      begin
         if Exact /= "" then
            return Exact;
         end if;
      end;

      --  Then each parent, longest first, which is the order the
      --  Fallback_Depth loop went in.
      declare
         Canon : constant String := Canonical_Locale (Locale);
         Cut : Natural := Canon'Last;
      begin
         while Cut > Canon'First loop
            if Canon (Cut) = '-' then
               declare
                  Hit : constant String :=
                    Lookup (Canon (Canon'First .. Cut - 1));
               begin
                  if Hit /= "" then
                     return Hit;
                  end if;
               end;
            end if;
            Cut := Cut - 1;
         end loop;
      end;

      return "";
   end Available_Format_Pattern;

   function Date_Time_Field_Separator
     (Locale     : String;
      Last_Class : Character;
      Class      : Character;
      Last_Field : Character;
      Field      : Character)
      return String
   is
      pragma Unreferenced (Locale);
   begin
      if Last_Class = 'D' and then Class = 'T' then
         return " ";
      elsif Class = 'T' and then Last_Class = 'T' then
         if Field = 'S' then
            return ".";
         elsif Last_Field in 'a' | 'b' | 'B' | 'z' | 'Z' | 'O'
             | 'v' | 'V' | 'X' | 'x' | 'S' | 'A'
           or else Field in 'a' | 'b' | 'B' | 'z' | 'Z' | 'O'
             | 'v' | 'V' | 'X' | 'x' | 'A'
         then
            return " ";
         else
            return ":";
         end if;
      else
         return " ";
      end if;
   end Date_Time_Field_Separator;

   function Date_Time_Style_Separator (Locale : String) return String is
      pragma Unreferenced (Locale);
   begin
      return " ";
   end Date_Time_Style_Separator;

   function Digit_Row (Locale : String) return String is
      Values : constant String :=
        "";
      Index_Data : constant String :=
        "ar            0000000100000080ar-bh         0000000100000080ar-dj         0000000100000080ar-eg         0000000100000080ar-er         0000000100000080ar-il         0000000100000080ar-iq         0000000100000080ar-jo         0000000100000080ar-km         0000000100000080ar-kw         0000000100000080ar-lb         0000000100000080ar-mr         0000000100000080ar-om         0000000100000080ar-ps         0000000100000080ar-qa         0000000100000080ar-sa         0000000100000080ar-sd         0000000100000080ar-so         0000000100000080ar-ss         0000000100000080ar-sy         0000000100000080ar-td         0000000100000080ar-ye         0000000100000080as            0000008100000160az-arab       0000016100000240az-arab-iq    0000016100000240az-arab-tr    0000016100000240bgc           0000024100000320bgn           0000016100000240bgn-ae        0000016100000240bgn-af        0000016100000240bgn-ir        0000016100000240bgn-om        0000016100000240bho           0000024100000320bn            0000008100000160bn-in         0000008100000160ccp           0000032100000400ccp-in        0000032100000400ckb           0000000100000080ckb-ir        0000000100000080dz            0000040100000480fa            0000016100000240fa-af         0000016100000240ff-adlm       0000048100000560ff-adlm-bf    0000048100000560ff-adlm-cm    0000048100000560ff-adlm-gh    0000048100000560ff-adlm-gm    0000048100000560ff-adlm-gw    0000048100000560ff-adlm-lr    0000048100000560ff-adlm-mr    0000048100000560ff-adlm-ne    0000048100000560ff-adlm-ng    0000048100000560ff-adlm-sl    0000048100000560ff-adlm-sn    0000048100000560hnj           0000056100000640hnj-hmnp      0000056100000640ks            0000016100000240ks-arab       0000016100000240lrc           0000016100000240lrc-iq        0000016100000240mni           0000008100000160mni-beng      0000008100000160mni-mtei      0000064100000720mr            0000024100000320mww           0000056100000640mww-hmnp      0000056100000640my            0000072100000800mzn           0000016100000240ne            0000024100000320ne-in         0000024100000320nqo           0000080100000880pa-arab       0000016100000240ps            0000016100000240ps-pk         0000016100000240raj           0000024100000320sa            0000024100000320sat           0000088100000960sat-deva      0000024100000320sat-olck      0000088100000960sd            0000000100000080sd-arab       0000000100000080sdh           0000000100000080sdh-iq        0000000100000080th            0000096100001040ur-in         0000016100000240uz-arab       0000016100000240";
      Width : constant := 30;
      Count : constant Natural := Index_Data'Length / Width;

      function Key (N : Positive) return String is
        (Index_Data (Index_Data'First + (N - 1) * Width ..
                     Index_Data'First + (N - 1) * Width + 13));

      function Padded (Cand : String) return String is
        (if Cand'Length >= 14 then Cand (Cand'First .. Cand'First + 13)
         else Cand & (1 .. 14 - Cand'Length => ' '));

      function Value_At (N : Positive) return String is
         Base : constant Natural :=
           Index_Data'First + (N - 1) * Width + 14;
         F : constant Natural :=
           Natural'Value (Index_Data (Base .. Base + 7));
         T : constant Natural :=
           Natural'Value (Index_Data (Base + 8 .. Base + 15));
      begin
         return HB (Values (F .. T));
      end Value_At;

      --  Keys are stored canonical, so canonicalise once and
      --  bisect. Nothing walks: a locale the table does not hold
      --  costs the same handful of comparisons as one it does.
      function Lookup (Cand : String) return String is
         Low : Natural := 1;
         High : Natural := Count;
         Mid : Natural;
      begin
         if Cand'Length = 0 or else Count = 0 then
            return "";
         end if;

         declare
            Wanted : constant String :=
              Padded (Canonical_Locale (Cand));
         begin
            while Low <= High loop
               Mid := (Low + High) / 2;
               if Key (Mid) = Wanted then
                  return Value_At (Mid);
               elsif Key (Mid) < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end loop;
         end;
         return "";
      end Lookup;

      --  Parents are cut from the canonical spelling: "de_AT" has
      --  no '-' to cut, and would otherwise lose its fallback.
      Canon : constant String := Canonical_Locale (Locale);
      Exact : constant String := Lookup (Locale);
      Cut : Natural := Canon'Last;
   begin
      if Exact /= "" then
         return Exact;
      end if;

      --  Then each parent, which is what the fallback pass did.
      while Cut > Canon'First loop
         if Canon (Cut) = '-' then
            declare
               Hit : constant String :=
                 Lookup (Canon (Canon'First .. Cut - 1));
            begin
               if Hit /= "" then
                  return Hit;
               end if;
            end;
         end if;
         Cut := Cut - 1;
      end loop;

      return "";
   end Digit_Row;

