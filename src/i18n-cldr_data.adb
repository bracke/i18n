         Base : constant Natural :=
           Locale_Index'First + (N - 1) * Width + 14;
         F : constant Natural :=
           Natural'Value (Locale_Index (Base .. Base + 7));
         T : constant Natural :=
           Natural'Value (Locale_Index (Base + 8 .. Base + 15));
