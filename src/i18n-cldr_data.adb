      Width : constant := 30;
      Count : constant Natural := Index_Data'Length / Width;

      function Key (N : Positive) return String is
        (Index_Data (Index_Data'First + (N - 1) * Width ..
                     Index_Data'First + (N - 1) * Width + 13));

      function Padded (Cand : String) return String is
        (if Cand'Length >= 14 then Cand (Cand'First .. Cand'First + 13)
         else Cand & (1 .. 14 - Cand'Length => ' '));

      function Value_At (N : Positive) return String is
         Base : constant Natural :=
           Index_Data'First + (N - 1) * Width + 14;
         F : constant Natural :=
           Natural'Value (Index_Data (Base .. Base + 7));
         T : constant Natural :=
           Natural'Value (Index_Data (Base + 8 .. Base + 15));
      begin
         return Values (F .. T);
      end Value_At;

      function Lookup (Cand : String; Canonical : Boolean) return String is
         Low : Natural := 1;
         High : Natural := Count;
         Mid : Natural;
      begin
         if Cand'Length = 0 or else Count = 0 then
            return "";
         end if;

         if Canonical then
            --  A locale spelled some other way does not sort where
            --  its canonical form would, so this one is a walk.
            for N in 1 .. Count loop
               declare
                  K : constant String := Key (N);
                  Stop : Natural := K'Last;
               begin
                  while Stop >= K'First and then K (Stop) = ' ' loop
                     Stop := Stop - 1;
                  end loop;
                  if Locale_Equals (Cand, K (K'First .. Stop)) then
                     return Value_At (N);
                  end if;
               end;
            end loop;
            return "";
         end if;

         declare
            Wanted : constant String := Padded (Cand);
         begin
            while Low <= High loop
               Mid := (Low + High) / 2;
               if Key (Mid) = Wanted then
                  return Value_At (Mid);
               elsif Key (Mid) < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end loop;
         end;
         return "";
      end Lookup;

      --  Bisect on the spelling as written, which answers almost
      --  every call; only a caller who spelled it some other way
      --  ("DE_at") pays for the walk.
      function Resolve (Cand : String) return String is
         Hit : constant String := Lookup (Cand, False);
      begin
         if Hit /= "" then
            return Hit;
         end if;
         return Lookup (Cand, True);
      end Resolve;

      Exact : constant String := Resolve (Locale);
   begin
      if Exact /= "" then
         return Exact;
      end if;

      return "";
   end Zone_Family_Row;

   --  Which: 1 standard, 2 daylight, 3 generic.
   function Zone_Family_Value
     (Payload : String;
      Family  : String;
      Which   : Positive)
      return String
   is
      Start : Positive := Payload'First;
      Stop  : Natural;
      Last  : Natural;
   begin
      while Start <= Payload'Last loop
         Stop := Start;
         while Stop <= Payload'Last and then Payload (Stop) /= ';' loop
            Stop := Stop + 1;
         end loop;
         Last := Stop - 1;

         declare
            Sep_1 : Natural := 0;
            Sep_2 : Natural := 0;
            Sep_3 : Natural := 0;
         begin
            for Index in Start .. Last loop
               if Payload (Index) = ',' then
                  if Sep_1 = 0 then
                     Sep_1 := Index;
                  elsif Sep_2 = 0 then
                     Sep_2 := Index;
                  else
                     Sep_3 := Index;
                     exit;
                  end if;
               end if;
            end loop;

            if Sep_3 > 0
              and then Payload (Start .. Sep_1 - 1) = Family
            then
               case Which is
                  when 1 => return HB (Payload (Sep_1 + 1 .. Sep_2 - 1));
                  when 2 => return HB (Payload (Sep_2 + 1 .. Sep_3 - 1));
                  when others => return HB (Payload (Sep_3 + 1 .. Last));
               end case;
            end if;
         end;
         Start := Stop + 1;
      end loop;

      return "";
   end Zone_Family_Value;

   function Time_Zone_Short_Name
     (Locale   : String;
      Family   : String;
      Daylight : Boolean)
      return String
   is
      function Find (Cand : String) return String is
         Row : constant String := Zone_Family_Row (Cand);
      begin
         if Row = "" then
            return "";
         end if;
         return Zone_Family_Value (Row, Family, (if Daylight then 2 else 1));
      end Find;

      Canon : constant String := Canonical_Locale (Locale);
      Exact : constant String := Find (Locale);
      Cut : Natural := Canon'Last;
   begin
      if Exact /= "" then
         return Exact;
      end if;

      while Cut > Canon'First loop
         if Canon (Cut) = '-' then
            declare
               Hit : constant String :=
                 Find (Canon (Canon'First .. Cut - 1));
            begin
               if Hit /= "" then
                  return Hit;
               end if;
            end;
         end if;
         Cut := Cut - 1;
      end loop;

      --  The chain ended on en's rows, which the table holds too.
      return Find ("en");
   end Time_Zone_Short_Name;

   function Time_Zone_Generic_Short_Name
     (Locale : String;
      Family : String)
      return String
   is
      function Find (Cand : String) return String is
         Row : constant String := Zone_Family_Row (Cand);
      begin
         if Row = "" then
            return "";
         end if;
         return Zone_Family_Value (Row, Family, 3);
      end Find;

      Canon : constant String := Canonical_Locale (Locale);
      Exact : constant String := Find (Locale);
      Cut : Natural := Canon'Last;
   begin
      if Exact /= "" then
         return Exact;
      end if;

      while Cut > Canon'First loop
         if Canon (Cut) = '-' then
            declare
               Hit : constant String :=
                 Find (Canon (Canon'First .. Cut - 1));
            begin
               if Hit /= "" then
                  return Hit;
               end if;
            end;
         end if;
         Cut := Cut - 1;
      end loop;

      --  The chain ended on en's rows, which the table holds too.
      return Find ("en");
   end Time_Zone_Generic_Short_Name;


