   function Time_Zone_Display_Name
     (Locale : String;
      Zone   : String)
      return String
   is
      Lang   : constant String := Language (Locale);
      Family : constant String := Time_Zone_DST_Family (Zone);
   begin
      if Zone = ""
        or else Zone = "UTC"
        or else Zone = "Z"
        or else Zone = "GMT"
      then
         return "UTC";
      end if;

      if Lang = "de" then
         if Family = "europe-central" then
            return "Mitteleurop" & U (16#E4#) & "ische Zeit";
         elsif Family = "europe-london" then
            return "Westeurop" & U (16#E4#) & "ische Zeit";
         elsif Family = "europe-eastern" then
            return "Osteurop" & U (16#E4#) & "ische Zeit";
         elsif Family = "america-eastern" then
            return "Nordamerikanische Ostk" & U (16#FC#)
              & "stenzeit";
         elsif Family = "america-central" then
            return "Nordamerikanische Zentralzeit";
