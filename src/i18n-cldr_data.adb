      Width : constant := 30;
      Count : constant Natural := Index_Data'Length / Width;

      function Key (N : Positive) return String is
        (Index_Data (Index_Data'First + (N - 1) * Width ..
                     Index_Data'First + (N - 1) * Width + 13));

      function Padded (Cand : String) return String is
        (if Cand'Length >= 14 then Cand (Cand'First .. Cand'First + 13)
         else Cand & (1 .. 14 - Cand'Length => ' '));

      function Value_At (N : Positive) return String is
         Base : constant Natural :=
           Index_Data'First + (N - 1) * Width + 14;
         F : constant Natural :=
           Natural'Value (Index_Data (Base .. Base + 7));
         T : constant Natural :=
           Natural'Value (Index_Data (Base + 8 .. Base + 15));
      begin
         return Values (F .. T);
      end Value_At;

      function Lookup (Cand : String; Canonical : Boolean) return String is
         Low : Natural := 1;
         High : Natural := Count;
         Mid : Natural;
      begin
         if Cand'Length = 0 or else Count = 0 then
            return "";
         end if;

         if Canonical then
            --  A locale spelled some other way does not sort where
            --  its canonical form would, so this one is a walk.
            for N in 1 .. Count loop
               declare
                  K : constant String := Key (N);
                  Stop : Natural := K'Last;
               begin
                  while Stop >= K'First and then K (Stop) = ' ' loop
                     Stop := Stop - 1;
                  end loop;
                  if Locale_Equals (Cand, K (K'First .. Stop)) then
                     return Value_At (N);
                  end if;
               end;
            end loop;
            return "";
         end if;

         declare
            Wanted : constant String := Padded (Cand);
         begin
            while Low <= High loop
               Mid := (Low + High) / 2;
               if Key (Mid) = Wanted then
                  return Value_At (Mid);
               elsif Key (Mid) < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end loop;
         end;
         return "";
      end Lookup;

      --  Bisect on the spelling as written, which answers almost
      --  every call; only a caller who spelled it some other way
      --  ("DE_at") pays for the walk.
      function Resolve (Cand : String) return String is
         Hit : constant String := Lookup (Cand, False);
      begin
         if Hit /= "" then
            return Hit;
         end if;
         return Lookup (Cand, True);
      end Resolve;

      Exact : constant String := Resolve (Locale);
   begin
      if Exact /= "" then
         return Exact;
      end if;

      return "";
   end Zone_Display_Row;

   function Time_Zone_Display_Name
     (Locale : String;
      Zone   : String)
      return String
   is
      Lang   : constant String := Language (Locale);
      Family : constant String := Time_Zone_DST_Family (Zone);


      function Search (Rows : String; Wanted : String) return String is
         Start : Positive := Rows'First;
      begin
         while Start <= Rows'Last loop
            declare
               Sep : Natural := 0;
               Stop : Natural := Rows'Last + 1;
            begin
               for Index in Start .. Rows'Last loop
                  if Rows (Index) = '|' and then Sep = 0 then
                     Sep := Index;
                  elsif Rows (Index) = '~' then
                     Stop := Index;
                     exit;
                  end if;
               end loop;

               if Sep /= 0
                 and then Sep > Start
                 and then Stop > Sep + 1
                 and then Rows (Start .. Sep - 1) = Wanted
               then
                  return HB (Rows (Sep + 1 .. Stop - 1));
               end if;

               Start := Stop + 1;
            end;
         end loop;

         return "";
      end Search;

      --  The locale, then each parent, longest first.
      function Family_Display return String is
         Exact : constant String := Search (Zone_Family_Display_Row (Locale), Family);
         Canon : constant String := Canonical_Locale (Locale);
         Cut : Natural := Canon'Last;
      begin
         if Exact /= "" then
            return Exact;
         end if;

         while Cut > Canon'First loop
            if Canon (Cut) = '-' then
               declare
                  Hit : constant String :=
                    Search
                      (Zone_Family_Display_Row (Canon (Canon'First .. Cut - 1)), Family);
               begin
                  if Hit /= "" then
                     return Hit;
                  end if;
               end;
            end if;
            Cut := Cut - 1;
         end loop;

         return "";
      end Family_Display;

      --  The locale, then each parent, longest first.
      function Zone_Display return String is
         Exact : constant String := Search (Zone_Display_Row (Locale), Zone);
         Canon : constant String := Canonical_Locale (Locale);
         Cut : Natural := Canon'Last;
      begin
         if Exact /= "" then
            return Exact;
         end if;

         while Cut > Canon'First loop
            if Canon (Cut) = '-' then
               declare
                  Hit : constant String :=
                    Search
                      (Zone_Display_Row (Canon (Canon'First .. Cut - 1)), Zone);
               begin
                  if Hit /= "" then
                     return Hit;
                  end if;
               end;
            end if;
            Cut := Cut - 1;
         end loop;

         return "";
      end Zone_Display;
      Family_Value : constant String := Family_Display;
   begin
      if Family_Value /= "" then
         return Family_Value;
      end if;

      declare
         Zone_Value : constant String := Zone_Display;
      begin
         if Zone_Value /= "" then
            return Zone_Value;
         end if;
      end;

      if Zone = ""
        or else Zone = "UTC"
        or else Zone = "Z"
        or else Zone = "GMT"
      then
         return "UTC";
      end if;

      if Lang = "de" then
         if Family = "europe-central" then
            return "Mitteleurop" & U (16#E4#) & "ische Zeit";
         elsif Family = "europe-london" then
            return "Westeurop" & U (16#E4#) & "ische Zeit";
         elsif Family = "europe-eastern" then
            return "Osteurop" & U (16#E4#) & "ische Zeit";
         elsif Family = "america-eastern" then
            return "Nordamerikanische Ostk" & U (16#FC#)
              & "stenzeit";
         elsif Family = "america-central" then
            return "Nordamerikanische Zentralzeit";
         elsif Family = "america-mountain" then
            return "Rocky-Mountain-Zeit";
         elsif Family = "america-pacific" then
            return "Nordamerikanische Westk" & U (16#FC#)
              & "stenzeit";
         elsif Family = "pacific-new-zealand" then
            return "Neuseeland-Zeit";
         elsif Family = "australia-eastern" then
            return "Ostaustralische Zeit";
         elsif Family = "australia-central" then
            return "Zentralaustralische Zeit";
         end if;
      elsif Lang = "ru" then
         if Family = "europe-central" then
            return UTF8 ([16#446#, 16#435#, 16#43D#, 16#442#,
              16#440#, 16#430#, 16#43B#, 16#44C#, 16#43D#,
