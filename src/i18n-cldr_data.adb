   function Byte_Size_Unit_Label (Scale : Long_Long_Integer) return String is
   begin
      if Scale = 1_125_899_906_842_624 then
         return "PiB";
      elsif Scale = 1_099_511_627_776 then
         return "TiB";
      elsif Scale = 1_073_741_824 then
         return "GiB";
      elsif Scale = 1_048_576 then
         return "MiB";
      elsif Scale = 1_024 then
         return "KiB";
      elsif Scale = 1 then
         return "B";
      else
         return "";
      end if;
   end Byte_Size_Unit_Label;

   function Spellout_Cardinal_Under_20
