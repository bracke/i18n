               Hit : constant String :=
                 Lookup (Canon (Canon'First .. Cut - 1));
            begin
               if Hit /= "" then
                  return Hit;
               end if;
            end;
         end if;
         Cut := Cut - 1;
      end loop;

      return "GMT";
   end GMT_Offset_Prefix;

