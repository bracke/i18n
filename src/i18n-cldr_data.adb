   function Lower (C : Character) return Character is
   begin
      if C in 'A' .. 'Z' then
         return Character'Val (Character'Pos (C) + 32);
      end if;

      return C;
   end Lower;

   function Language (Locale : String) return String is
      First : constant Positive := Locale'First;
   begin
