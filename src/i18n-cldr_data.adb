   --  Which: 1 standard, 2 daylight, 3 generic.
   function Zone_Family_Value
     (Payload : String;
      Family  : String;
      Which   : Positive)
      return String
   is
      Start : Positive := Payload'First;
      Stop  : Natural;
      Last  : Natural;
   begin
      while Start <= Payload'Last loop
         Stop := Start;
         while Stop <= Payload'Last and then Payload (Stop) /= ';' loop
            Stop := Stop + 1;
         end loop;
         Last := Stop - 1;

         declare
            Sep_1 : Natural := 0;
            Sep_2 : Natural := 0;
            Sep_3 : Natural := 0;
         begin
            for Index in Start .. Last loop
               if Payload (Index) = ',' then
                  if Sep_1 = 0 then
                     Sep_1 := Index;
                  elsif Sep_2 = 0 then
                     Sep_2 := Index;
                  else
                     Sep_3 := Index;
                     exit;
                  end if;
               end if;
            end loop;

            if Sep_3 > 0
              and then Payload (Start .. Sep_1 - 1) = Family
            then
               case Which is
                  when 1 => return VB (Payload (Sep_1 + 1 .. Sep_2 - 1));
                  when 2 => return VB (Payload (Sep_2 + 1 .. Sep_3 - 1));
                  when others => return VB (Payload (Sep_3 + 1 .. Last));
               end case;
            end if;
         end;
         Start := Stop + 1;
      end loop;

      return "";
   end Zone_Family_Value;

   function Time_Zone_Short_Name
     (Locale   : String;
      Family   : String;
      Daylight : Boolean)
      return String
   is
      function Find (Cand : String) return String is
         Row : constant String := Zone_Family_Row (Cand);
      begin
         if Row = "" then
            return "";
         end if;
         return Zone_Family_Value (Row, Family, (if Daylight then 2 else 1));
      end Find;

      Canon : constant String := Canonical_Locale (Locale);
      Exact : constant String := Find (Locale);
      Cut : Natural := Canon'Last;
   begin
      if Exact /= "" then
         return Exact;
      end if;

      while Cut > Canon'First loop
         if Canon (Cut) = '-' then
            declare
               Hit : constant String :=
                 Find (Canon (Canon'First .. Cut - 1));
            begin
               if Hit /= "" then
                  return Hit;
               end if;
            end;
         end if;
         Cut := Cut - 1;
      end loop;

      --  The chain ended on en's rows, which the table holds too.
      return Find ("en");
   end Time_Zone_Short_Name;

   function Time_Zone_Generic_Short_Name
     (Locale : String;
      Family : String)
      return String
   is
      function Find (Cand : String) return String is
         Row : constant String := Zone_Family_Row (Cand);
      begin
         if Row = "" then
            return "";
         end if;
         return Zone_Family_Value (Row, Family, 3);
      end Find;

      Canon : constant String := Canonical_Locale (Locale);
      Exact : constant String := Find (Locale);
      Cut : Natural := Canon'Last;
   begin
      if Exact /= "" then
         return Exact;
      end if;

      while Cut > Canon'First loop
         if Canon (Cut) = '-' then
            declare
               Hit : constant String :=
                 Find (Canon (Canon'First .. Cut - 1));
            begin
               if Hit /= "" then
                  return Hit;
               end if;
            end;
         end if;
         Cut := Cut - 1;
      end loop;

      --  The chain ended on en's rows, which the table holds too.
      return Find ("en");
   end Time_Zone_Generic_Short_Name;


