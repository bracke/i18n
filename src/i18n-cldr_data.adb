   function Spellout_Scale_Name
     (Locale  : String;
      Scale   : Natural;
      Ordinal : Boolean := False)
      return String
   is
      pragma Unreferenced (Locale);
   begin
      if Scale = 100 then
         return (if Ordinal then "hundredth" else "hundred");
      elsif Scale = 1_000 then
         return (if Ordinal then "thousandth" else "thousand");
      elsif Scale = 1_000_000 then
         return (if Ordinal then "millionth" else "million");
      else
         return "";
      end if;
   end Spellout_Scale_Name;

