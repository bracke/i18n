   function Time_Style_Pattern
     (Locale     : String;
      Style      : String;
      Has_Second : Boolean)
      return String
   is
      Lang : constant String := Language (Locale);
   begin
      if Lang = "ko" then
         if Style = "long" or else Style = "full" then
            return "ah':'mm':'ss";
         elsif Style = "" or else Style = "medium" then
            return (if Has_Second then "ah':'mm':'ss" else "ah':'mm");
         else
            return "ah':'mm";
         end if;
      elsif Style = "long" or else Style = "full" then
         return "HH':'mm':'ss";
      elsif Style = "" or else Style = "medium" then
         return (if Has_Second then "HH':'mm':'ss" else "HH':'mm");
      else
         return "HH':'mm";
      end if;
   end Time_Style_Pattern;

   function Date_Time_Field_Separator
     (Locale     : String;
      Last_Class : Character;
      Class      : Character;
      Last_Field : Character;
      Field      : Character)
      return String
   is
      pragma Unreferenced (Locale);
   begin
      if Last_Class = 'D' and then Class = 'T' then
         return " ";
      elsif Class = 'T' and then Last_Class = 'T' then
         if Field = 'S' then
            return ".";
         elsif Last_Field in 'a' | 'b' | 'B' | 'z' | 'Z' | 'O'
             | 'v' | 'V' | 'X' | 'x' | 'S' | 'A'
           or else Field in 'a' | 'b' | 'B' | 'z' | 'Z' | 'O'
             | 'v' | 'V' | 'X' | 'x' | 'A'
         then
            return " ";
         else
            return ":";
         end if;
      else
         return " ";
      end if;
   end Date_Time_Field_Separator;

