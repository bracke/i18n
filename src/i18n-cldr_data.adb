      Width : constant := 30;
      Count : constant Natural := Index_Data'Length / Width;

      function Key (N : Positive) return String is
        (Index_Data (Index_Data'First + (N - 1) * Width ..
                     Index_Data'First + (N - 1) * Width + 13));

      function Padded (Cand : String) return String is
        (if Cand'Length >= 14 then Cand (Cand'First .. Cand'First + 13)
         else Cand & (1 .. 14 - Cand'Length => ' '));

      function Value_At (N : Positive) return String is
         Base : constant Natural :=
           Index_Data'First + (N - 1) * Width + 14;
         F : constant Natural :=
           Natural'Value (Index_Data (Base .. Base + 7));
         T : constant Natural :=
           Natural'Value (Index_Data (Base + 8 .. Base + 15));
      begin
         return HB (Values (F .. T));
      end Value_At;

      function Lookup (Cand : String; Canonical : Boolean) return String is
         Low : Natural := 1;
         High : Natural := Count;
         Mid : Natural;
      begin
         if Cand'Length = 0 or else Count = 0 then
            return "";
         end if;

         if Canonical then
            --  A locale spelled some other way does not sort where
            --  its canonical form would, so this one is a walk.
            for N in 1 .. Count loop
               declare
                  K : constant String := Key (N);
                  Stop : Natural := K'Last;
               begin
                  while Stop >= K'First and then K (Stop) = ' ' loop
                     Stop := Stop - 1;
                  end loop;
                  if Locale_Equals (Cand, K (K'First .. Stop)) then
                     return Value_At (N);
                  end if;
               end;
            end loop;
            return "";
         end if;

         declare
            Wanted : constant String := Padded (Cand);
         begin
            while Low <= High loop
               Mid := (Low + High) / 2;
               if Key (Mid) = Wanted then
                  return Value_At (Mid);
               elsif Key (Mid) < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end loop;
         end;
         return "";
      end Lookup;

      --  Bisect on the spelling as written, which answers almost
      --  every call; only a caller who spelled it some other way
      --  ("DE_at") pays for the walk.
      function Resolve (Cand : String) return String is
         Hit : constant String := Lookup (Cand, False);
      begin
         if Hit /= "" then
            return Hit;
         end if;
         return Lookup (Cand, True);
      end Resolve;

      --  Parents are cut from the canonical spelling: "de_AT" has
      --  no '-' to cut, and would otherwise lose its fallback.
      Canon : constant String := Canonical_Locale (Locale);
      Exact : constant String := Resolve (Locale);
      Cut : Natural := Canon'Last;
   begin
      if Exact /= "" then
         return Exact;
      end if;

      --  Then each parent, which is what the fallback pass did.
      while Cut > Canon'First loop
         if Canon (Cut) = '-' then
            declare
               Hit : constant String :=
                 Resolve (Canon (Canon'First .. Cut - 1));
            begin
               if Hit /= "" then
                  return Hit;
               end if;
            end;
         end if;
         Cut := Cut - 1;
      end loop;

      return "/";
   end Per_Unit_Separator;

   function Unit_Value_Separator (Locale : String) return String is
      Lang : constant String := Language (Locale);
   begin
      if Lang = "ja" or else Lang = "zh" or else Lang = "ko" then
         return "";
      else
         return " ";
      end if;
   end Unit_Value_Separator;

   function Unit_Short_Per_Separator (Locale : String) return String is
      pragma Unreferenced (Locale);
   begin
      return "/";
   end Unit_Short_Per_Separator;

   function Duration_Field_Separator (Locale : String) return String is
      pragma Unreferenced (Locale);
   begin
      return ":";
   end Duration_Field_Separator;

   function Unit_Display_Name
     (Locale   : String;
      Base     : String;
      Width    : String;
      Category : String)
      return String
   is separate;

   function Byte_Size_Unit_Label (Scale : Long_Long_Integer) return String is
   begin
      if Scale = 1_125_899_906_842_624 then
         return "PiB";
      elsif Scale = 1_099_511_627_776 then
         return "TiB";
      elsif Scale = 1_073_741_824 then
         return "GiB";
      elsif Scale = 1_048_576 then
         return "MiB";
      elsif Scale = 1_024 then
         return "KiB";
      elsif Scale = 1 then
         return "B";
      else
         return "";
      end if;
   end Byte_Size_Unit_Label;

   function Spellout_Cardinal_Under_20
     (Locale : String;
      Value  : Natural)
      return String
   is
      pragma Unreferenced (Locale);
   begin
      case Value is
         when 0 => return "zero";
         when 1 => return "one";
         when 2 => return "two";
         when 3 => return "three";
         when 4 => return "four";
         when 5 => return "five";
         when 6 => return "six";
         when 7 => return "seven";
         when 8 => return "eight";
         when 9 => return "nine";
         when 10 => return "ten";
         when 11 => return "eleven";
         when 12 => return "twelve";
         when 13 => return "thirteen";
         when 14 => return "fourteen";
         when 15 => return "fifteen";
         when 16 => return "sixteen";
         when 17 => return "seventeen";
         when 18 => return "eighteen";
         when 19 => return "nineteen";
         when others => return "";
      end case;
   end Spellout_Cardinal_Under_20;

