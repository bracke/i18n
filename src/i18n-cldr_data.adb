                  Dash := Index;
                  exit;
               end if;
            end loop;

            exit when Dash = 0;
            Last := Dash - 1;
            if Current (1 .. Last) = Target then
               return True;
            end if;
         end;
      end loop;

      return False;
   end Locale_Fallback_Matches;

   function Locale_In_List
     (Locale           : String;
      List             : String;
      Include_Fallback : Boolean)
