   function Locale_In_List
     (Locale           : String;
      List             : String;
      Include_Fallback : Boolean)
      return Boolean
   is
      Start : Positive := List'First;

      function Matches (Candidate : String) return Boolean is
      begin
         if Locale_Equals (Locale, Candidate) then
            return True;
         elsif Include_Fallback then
            return Locale_Fallback_Matches (Locale, Candidate);
         else
            return False;
         end if;
