urope/Busingen                 aaarvaaarHEurope/Kiev                     aaarIaaarSEurope/Mariehamn      "
        & "          aaarTaaar7Europe/Nicosia                  aaar8aaasjEurope/Podgorica                aaaskaaasyEurope/San_Marino               aaaszaaasJEurope/Tiraspol                 aaasKaaasYEurope/Uzhgorod                 aaarIaaarSEurope/Vatican                  aaaszaaasJEurope/Zaporozhye               aaarIaaarSGB                              aaaq5aaarhGB-Eire                         aaaq5aaarhGMT                             aaaqRaaaqXGMT+0                           aaaqRaaaqXGMT-0                           aaaqRaaaqXGMT0                            aaaqRaaaqXGreenwich                       aaaqRaaaqXHST                             aaasZaaateHongkong                        aaatfaaatsIceland                         aaaapaaaaCIran                            aaattaaatDIsrael                          aaajmaaajzJamaica                         aaatEaaatSJapan                           aaatTaaat2Kwajalein                       aaat3aaaujLibya                           aaaukaaauxMET                             aaanvaaanJMST                             aaauyaaauMMST7MDT                         aaaf8aaaglMexico/BajaNorte                aaacnaaacBMexico/BajaSur                  aaauNaaau2Mexico/General                  aaau3aaavlNZ                              aaagCaaagRNZ-CHAT                         aaavmaaavANavajo                          aaaf8aaaglPRC                             aaahKaaahWPST8PDT                         aaavBaaavTPacific/Enderbury               aaavUaaav7Pacific/Johnston                aaasZaaatePacific/Ponape                  aaav8aaawqPacific/Samoa                   aaawraaawHPacific/Truk                    aaawIaaaw1Pacific/Yap                     aaawIaaaw1Poland                          aaaw2aaaxePortugal                        aaaxfaaaxrROC                             aaaxsaaaxCROK                             aaaxDaaaxMSingapore                       aaaxNaaax0Turkey                          aaah7aaailUCT                             aaaqYaaaq4US/Alaska                       aaax1aaayhUS/Aleutian                     aaaa4aaabfUS/Arizona                      aaauyaaauMUS/Central                      aaanKaaanYUS/East-Indiana                 aaacCaaac3US/Eastern                      aaaqcaaaqrUS/Hawaii                       aaasZaaateUS/Indiana-Starke               aaadDaaadWUS/Michigan                     aaayiaaaywUS/Mountain                     aaaf8aaaglUS/Pacific                      aaavBaaavTUS/Samoa                        aaawraaawHUTC                             aaaqYaaaq4Universal                       aaaqYaaaq4W-SU                            aaayxaaayJWET                             aaaxfaaaxrZulu                            aaaqYaaaq4";
      Link_Width : constant := 32;
      Width : constant := Link_Width + 10;
      Count : constant Natural := Index_Data'Length / Width;

      function Key (N : Positive) return String is
        (Index_Data (Index_Data'First + (N - 1) * Width ..
                     Index_Data'First + (N - 1) * Width + Link_Width - 1));

      function Value_At (N : Positive) return String is
         Base : constant Natural :=
           Index_Data'First + (N - 1) * Width + Link_Width;
         F : constant Natural :=
           N62 (Index_Data (Base .. Base + 4));
         T : constant Natural :=
           N62 (Index_Data (Base + 5 .. Base + 9));
      begin
         return Values (F .. T);
      end Value_At;

      Low : Natural := 1;
      High : Natural := Count;
      Mid : Natural;
   begin
      if Zone = ""
        or else Zone = "UTC"
        or else Zone = "UCT"
        or else Zone = "Universal"
        or else Zone = "Zulu"
        or else Zone = "Etc/UTC"
        or else Zone = "Etc/UCT"
        or else Zone = "Etc/Universal"
        or else Zone = "Etc/Zulu"
      then
         return "UTC";
      end if;

      if Zone = "GMT" then
         return "GMT";
      end if;

      if Zone'Length <= Link_Width then
         declare
            Wanted : constant String :=
              Zone & [1 .. Link_Width - Zone'Length => ' '];
         begin
            while Low <= High loop
               Mid := (Low + High) / 2;
               if Key (Mid) = Wanted then
                  return Value_At (Mid);
               elsif Key (Mid) < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end loop;
         end;
      end if;
      return Zone;
   end Canonical_Time_Zone;

