      Width : constant := 30;
      Count : constant Natural := Index_Data'Length / Width;

      function Key (N : Positive) return String is
        (Index_Data (Index_Data'First + (N - 1) * Width ..
                     Index_Data'First + (N - 1) * Width + 13));

      function Padded (Cand : String) return String is
        (if Cand'Length >= 14 then Cand (Cand'First .. Cand'First + 13)
         else Cand & (1 .. 14 - Cand'Length => ' '));

      function Value_At (N : Positive) return String is
         Base : constant Natural :=
           Index_Data'First + (N - 1) * Width + 14;
         F : constant Natural :=
           Natural'Value (Index_Data (Base .. Base + 7));
         T : constant Natural :=
           Natural'Value (Index_Data (Base + 8 .. Base + 15));
      begin
         return Values (F .. T);
      end Value_At;

      --  Keys are stored canonical, so canonicalise once and
      --  bisect. Nothing walks: a locale the table does not hold
      --  costs the same handful of comparisons as one it does.
      function Lookup (Cand : String) return String is
         Low : Natural := 1;
         High : Natural := Count;
         Mid : Natural;
      begin
         if Cand'Length = 0 or else Count = 0 then
            return "";
         end if;

         declare
            Wanted : constant String :=
              Padded (Canonical_Locale (Cand));
         begin
            while Low <= High loop
               Mid := (Low + High) / 2;
               if Key (Mid) = Wanted then
                  return Value_At (Mid);
               elsif Key (Mid) < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end loop;
         end;
         return "";
      end Lookup;

      Exact : constant String := Lookup (Locale);
   begin
      if Exact /= "" then
         return Exact;
      end if;

      return "";
   end Zone_Display_Row;

   function Time_Zone_Display_Name
     (Locale : String;
      Zone   : String)
      return String
   is
      Lang   : constant String := Language (Locale);
      Family : constant String := Time_Zone_DST_Family (Zone);


      function Family_Code return String is
        (if Family = "america-central" then "a"
         elsif Family = "america-eastern" then "b"
         elsif Family = "america-mexico-city" then "c"
         elsif Family = "america-mountain" then "d"
         elsif Family = "america-pacific" then "e"
         elsif Family = "america-sao-paulo" then "f"
         elsif Family = "asia-jerusalem" then "g"
         elsif Family = "asia-tehran" then "h"
         elsif Family = "australia-central" then "i"
         elsif Family = "australia-central-western" then "j"
         elsif Family = "australia-eastern" then "k"
         elsif Family = "australia-lord-howe" then "l"
         elsif Family = "australia-western" then "m"
         elsif Family = "europe-central" then "n"
         elsif Family = "europe-eastern" then "o"
         elsif Family = "europe-london" then "p"
         elsif Family = "pacific-new-zealand" then "q"
         else " ");

      function Zone_Code return String is
        (if Zone = "Africa/Abidjan" then "a"
         elsif Zone = "Africa/Algiers" then "b"
         elsif Zone = "Africa/Johannesburg" then "c"
         elsif Zone = "Africa/Lagos" then "d"
         elsif Zone = "Africa/Nairobi" then "e"
         elsif Zone = "Africa/Tunis" then "f"
         elsif Zone = "America/Argentina/Buenos_Aires" then "g"
         elsif Zone = "America/Bogota" then "h"
         elsif Zone = "America/Lima" then "i"
         elsif Zone = "Asia/Baku" then "j"
         elsif Zone = "Asia/Bangkok" then "k"
         elsif Zone = "Asia/Colombo" then "l"
         elsif Zone = "Asia/Dhaka" then "m"
         elsif Zone = "Asia/Dubai" then "n"
         elsif Zone = "Asia/Ho_Chi_Minh" then "o"
         elsif Zone = "Asia/Hong_Kong" then "p"
         elsif Zone = "Asia/Jakarta" then "q"
         elsif Zone = "Asia/Karachi" then "r"
         elsif Zone = "Asia/Kathmandu" then "s"
         elsif Zone = "Asia/Kolkata" then "t"
         elsif Zone = "Asia/Kuala_Lumpur" then "u"
         elsif Zone = "Asia/Manila" then "v"
         elsif Zone = "Asia/Riyadh" then "w"
         elsif Zone = "Asia/Seoul" then "x"
         elsif Zone = "Asia/Shanghai" then "y"
         elsif Zone = "Asia/Singapore" then "z"
         elsif Zone = "Asia/Taipei" then "A"
         elsif Zone = "Asia/Tashkent" then "B"
         elsif Zone = "Asia/Tbilisi" then "C"
         elsif Zone = "Asia/Tokyo" then "D"
         elsif Zone = "Asia/Ulaanbaatar" then "E"
         elsif Zone = "Asia/Yangon" then "F"
         elsif Zone = "Asia/Yerevan" then "G"
         elsif Zone = "Etc/UTC" then "H"
         elsif Zone = "Europe/Moscow" then "I"
         elsif Zone = "Pacific/Honolulu" then "J"
         else " ");

      --  One coded character, then the hex. The same scan serves
      --  both tables: by here a key is only a code.
      function Search (Rows : String; Wanted : String) return String is
         Start : Positive := Rows'First;
      begin
         if Wanted = " " then
            return "";
         end if;

         while Start <= Rows'Last loop
            declare
               Stop : Natural := Rows'Last + 1;
            begin
               for Index in Start .. Rows'Last loop
                  if Rows (Index) = '~' then
                     Stop := Index;
                     exit;
                  end if;
               end loop;

               if Stop > Start + 1
                 and then Rows (Start .. Start) = Wanted
               then
                  return HB (Rows (Start + 1 .. Stop - 1));
               end if;

               Start := Stop + 1;
            end;
         end loop;

         return "";
      end Search;

      --  The locale, then each parent, longest first.
      function Family_Display return String is
         Exact : constant String :=
           Search (Zone_Family_Display_Row (Locale), Family_Code);
         Canon : constant String := Canonical_Locale (Locale);
         Cut : Natural := Canon'Last;
      begin
         if Exact /= "" then
            return Exact;
         end if;

         while Cut > Canon'First loop
            if Canon (Cut) = '-' then
               declare
                  Hit : constant String :=
                    Search
                      (Zone_Family_Display_Row (Canon (Canon'First .. Cut - 1)),
                       Family_Code);
               begin
                  if Hit /= "" then
                     return Hit;
                  end if;
               end;
            end if;
            Cut := Cut - 1;
         end loop;

         return "";
      end Family_Display;

      --  The locale, then each parent, longest first.
      function Zone_Display return String is
         Exact : constant String :=
           Search (Zone_Display_Row (Locale), Zone_Code);
         Canon : constant String := Canonical_Locale (Locale);
         Cut : Natural := Canon'Last;
      begin
         if Exact /= "" then
            return Exact;
         end if;

         while Cut > Canon'First loop
            if Canon (Cut) = '-' then
               declare
                  Hit : constant String :=
                    Search
                      (Zone_Display_Row (Canon (Canon'First .. Cut - 1)),
                       Zone_Code);
               begin
                  if Hit /= "" then
                     return Hit;
                  end if;
               end;
            end if;
            Cut := Cut - 1;
         end loop;

         return "";
      end Zone_Display;
      Family_Value : constant String := Family_Display;
   begin
      if Family_Value /= "" then
         return Family_Value;
      end if;

      declare
         Zone_Value : constant String := Zone_Display;
      begin
         if Zone_Value /= "" then
            return Zone_Value;
         end if;
      end;

      if Zone = ""
        or else Zone = "UTC"
        or else Zone = "Z"
        or else Zone = "GMT"
      then
