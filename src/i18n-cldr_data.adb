   function Number_Compact_Suffix
     (Locale    : String;
      Scale     : Long_Long_Integer;
      Long_Form : Boolean)
      return String
   is
      Lang : constant String := Language (Locale);
   begin
      if Lang = "ja" or else Lang = "zh" then
         if Scale = 10_000 then
            return U (16#4E07#);
         elsif Scale = 100_000_000 then
            return U (16#5104#);
         elsif Scale = 1_000_000_000_000 then
            return U (16#5146#);
         else
            return "";
         end if;
      elsif Lang = "ko" then
         if Scale = 10_000 then
            return U (16#B9CC#);
         elsif Scale = 100_000_000 then
            return U (16#C5B5#);
         elsif Scale = 1_000_000_000_000 then
            return U (16#C870#);
         else
            return "";
         end if;
      end if;

      if Long_Form then
         if Scale = 1_000 then
            return " thousand";
         elsif Scale = 1_000_000 then
            return " million";
         elsif Scale = 1_000_000_000 then
            return " billion";
         elsif Scale = 1_000_000_000_000 then
            return " trillion";
         else
            return "";
         end if;
      else
         if Scale = 1_000 then
            return "K";
         elsif Scale = 1_000_000 then
            return "M";
         elsif Scale = 1_000_000_000 then
            return "B";
         elsif Scale = 1_000_000_000_000 then
            return "T";
         else
            return "";
         end if;
      end if;
   end Number_Compact_Suffix;

