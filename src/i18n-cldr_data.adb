   function Currency_Minor_Units (Code : String) return Natural is
      Index_Data : constant String :=
        "ADPaaAFNaaALLaaBHDadBIFaaBYRaaCLFaeCLPaaCOPaaDJFaaESPaaGNFaaHUFaaIDRaaIQDaaIRRaaISKaaITLaaJODadJPYaaKMFaaKPWaaKRWaaKWDadLAKaaLBPaaLUFaaLYDadMGAaaMGFaaMMKaaMROaaOMRadPKRaaPYGaaRWFaaSLLaaSOSaaSTDaaSYPaaTMMaaTNDadTRLaaUGXaaUYIaaUYWaeVNDaaVUVaaXAFaaXOFaaXPFaaYERaaZMKaaZWDaa";
      Width : constant := 5;
      Count : constant Natural := Index_Data'Length / Width;

      function Key (N : Positive) return String is
        (Index_Data (Index_Data'First + (N - 1) * Width ..
                     Index_Data'First + (N - 1) * Width + 2));

      function Value_At (N : Positive) return Natural is
         Base : constant Natural :=
           Index_Data'First + (N - 1) * Width + 3;
      begin
         return N62 (Index_Data (Base .. Base + 1));
      end Value_At;

      Low : Natural := 1;
      High : Natural := Count;
      Mid : Natural;
   begin
      while Low <= High loop
         Mid := (Low + High) / 2;
         if Key (Mid) = Code then
            return Value_At (Mid);
         elsif Key (Mid) < Code then
            Low := Mid + 1;
         else
            High := Mid - 1;
         end if;
      end loop;
      return 2;
   end Currency_Minor_Units;

