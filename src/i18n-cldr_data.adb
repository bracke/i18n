   end Time_Zone_TZDB_Index;

   function TZDB_Key
     (Year   : Natural;
      Month  : Natural;
      Day    : Natural;
      Hour   : Natural;
      Minute : Natural;
      Second : Natural)
      return Long_Long_Integer
   is
   begin
      return (((((Long_Long_Integer (Year) * 100
                 + Long_Long_Integer (Month)) * 100
                + Long_Long_Integer (Day)) * 100
               + Long_Long_Integer (Hour)) * 100
              + Long_Long_Integer (Minute)) * 100
             + Long_Long_Integer (Second));
   end TZDB_Key;

   function Time_Zone_Offset_Seconds_At_UTC
     (Zone   : String;
      Year   : Natural;
      Month  : Natural;
      Day    : Natural;
      Hour   : Natural;
      Minute : Natural;
      Second : Natural;
      Valid  : out Boolean)
      return Integer
   is
      Index : constant Natural := Time_Zone_TZDB_Index (Zone);
   begin
      if Zone = ""
        or else Zone = "UTC"
        or else Zone = "Z"
        or else Zone = "GMT"
        or else Zone = "Etc/UTC"
        or else Zone = "Etc/GMT"
      then
         Valid := True;
         return 0;
      elsif Index = 0 then
         Valid := False;
         return 0;
      else
         declare
            Key : constant Long_Long_Integer :=
              TZDB_Key (Year, Month, Day, Hour, Minute, Second);
            First : constant Natural := TZDB_Zones (Index).First;
            Last  : constant Natural := TZDB_Zones (Index).Last;
         begin
            Valid := True;

            --  Past its recorded transitions a zone follows its final
            --  rule, every year from then on.
            if TZDB_Zones (Index).Rule_From /= 0
              and then Key >= TZDB_Zones (Index).Rule_From
            then
               declare
                  Rule_Valid : Boolean;
                  Offset     : constant Integer :=
                    I18N.TZ_Rules.Offset_At
                      (TZDB_Rules (TZDB_Zones (Index).Rule_First .. TZDB_Zones (Index).Rule_Last),
                       I18N.TZ_Rules.Epoch_Seconds (Year, Month, Day, Hour, Minute, Second),
                       Rule_Valid);
               begin
                  if Rule_Valid then
                     return Offset;
                  end if;
               end;
            end if;

            if First = 0 then
               return TZDB_Zones (Index).Initial_Offset;
            end if;

            --  Transitions are sorted ascending by Key, so the one
            --  in force is the last whose Key <= the query. Bisect
            --  for it rather than walking every transition, which
            --  an old query date did in full before falling back.
            declare
               Low   : Natural := First;
               High  : Natural := Last;
               Mid   : Natural;
               Found : Natural := 0;
            begin
               while Low <= High loop
                  Mid := Low + (High - Low) / 2;
                  if TZDB_Transitions (Mid).Key <= Key then
                     Found := Mid;
                     Low := Mid + 1;
                  else
                     High := Mid - 1;
                  end if;
               end loop;

               if Found /= 0 then
                  return TZDB_Transitions (Found).Offset;
               end if;
            end;

            return TZDB_Zones (Index).Initial_Offset;
         end;
      end if;
   end Time_Zone_Offset_Seconds_At_UTC;

