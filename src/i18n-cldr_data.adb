      elsif Lang = "ja" then
         if Family = "europe-central" then
            return UTF8 ([16#4E2D#, 16#592E#, 16#30E8#,
              16#30FC#, 16#30ED#, 16#30C3#, 16#30D1#,
              16#6642#, 16#9593#]);
         elsif Family = "america-eastern" then
            return UTF8 ([16#30A2#, 16#30E1#, 16#30EA#,
              16#30AB#, 16#6771#, 16#90E8#, 16#6642#,
              16#9593#]);
         elsif Family /= "none" then
            return UTF8 ([16#5730#, 16#57DF#, 16#6642#,
              16#9593#]);
         end if;
      elsif Lang = "zh" then
         if Family = "europe-central" then
