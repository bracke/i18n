      Width : constant := 30;
      Count : constant Natural := Index_Data'Length / Width;

      function Key (N : Positive) return String is
        (Index_Data (Index_Data'First + (N - 1) * Width ..
                     Index_Data'First + (N - 1) * Width + 13));

      function Padded (Cand : String) return String is
        (if Cand'Length >= 14 then Cand (Cand'First .. Cand'First + 13)
         else Cand & (1 .. 14 - Cand'Length => ' '));

      function Value_At (N : Positive) return String is
         Base : constant Natural :=
           Index_Data'First + (N - 1) * Width + 14;
         F : constant Natural :=
           Natural'Value (Index_Data (Base .. Base + 7));
         T : constant Natural :=
           Natural'Value (Index_Data (Base + 8 .. Base + 15));
      begin
         return Values (F .. T);
      end Value_At;

      --  Keys are stored canonical, so canonicalise once and
      --  bisect. Nothing walks: a locale the table does not hold
      --  costs the same handful of comparisons as one it does.
      function Lookup (Cand : String) return String is
         Low : Natural := 1;
         High : Natural := Count;
         Mid : Natural;
      begin
         if Cand'Length = 0 or else Count = 0 then
            return "";
         end if;

         declare
            Wanted : constant String :=
              Padded (Canonical_Locale (Cand));
         begin
            while Low <= High loop
               Mid := (Low + High) / 2;
               if Key (Mid) = Wanted then
                  return Value_At (Mid);
               elsif Key (Mid) < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end loop;
         end;
         return "";
      end Lookup;

      Exact : constant String := Lookup (Locale);
   begin
      if Exact /= "" then
         return Exact;
      end if;

      return "";
   end Relative_Pattern_Row;

   function Relative_Time_Pattern
     (Locale   : String;
      Base     : String;
      Width    : String;
      Category : String;
      Future   : Boolean)
      return String
   is
      Direction : constant String :=
        (if Future then "future" else "past");

      function Base_Code return String is
        (if Base = "day" then "a"
         elsif Base = "hour" then "b"
         elsif Base = "minute" then "c"
         elsif Base = "month" then "d"
         elsif Base = "quarter" then "e"
         elsif Base = "second" then "f"
         elsif Base = "week" then "g"
         elsif Base = "year" then "h"
         else " ");
      function Width_Code return String is
        (if Width = "unit-width-full-name" then "a"
         elsif Width = "unit-width-narrow" then "b"
         elsif Width = "unit-width-short" then "c"
         else " ");
      function Dir_Code return String is
        (if Direction = "future" then "a"
         elsif Direction = "past" then "b"
         else " ");

      function Cat_Code (Want : String) return String is
        (if Want = "few" then "a"
         elsif Want = "many" then "b"
         elsif Want = "one" then "c"
         elsif Want = "other" then "d"
         elsif Want = "two" then "e"
         elsif Want = "zero" then "f"
         else " ");

      Fixed : constant String := Base_Code & Width_Code & Dir_Code;

      --  Four coded characters, then the hex. The labels they
      --  replace were nearly half of this table.
      function Search (Rows : String; Wanted : String) return String is
         Start : Positive := Rows'First;
         Key : constant String := Fixed & Cat_Code (Wanted);
      begin
         for Index in Key'Range loop
            if Key (Index) = ' ' then
               return "";
            end if;
         end loop;

         while Start <= Rows'Last loop
            declare
               Stop : Natural := Rows'Last + 1;
            begin
               for Index in Start .. Rows'Last loop
                  if Rows (Index) = '~' then
                     Stop := Index;
                     exit;
                  end if;
               end loop;

               if Stop > Start + 4
                 and then Rows (Start .. Start + 3) = Key
               then
                  return HB (Rows (Start + 4 .. Stop - 1));
               end if;

               Start := Stop + 1;
            end;
         end loop;

         return "";
      end Search;

      --  Each parent in turn, longest first.
      function Walk (Wanted : String) return String is
         Canon : constant String := Canonical_Locale (Locale);
         Cut : Natural := Canon'Last;
      begin
         while Cut > Canon'First loop
            if Canon (Cut) = '-' then
               declare
                  Rows : constant String :=
                    Relative_Pattern_Row (Canon (Canon'First .. Cut - 1));
                  Hit : constant String := Search (Rows, Wanted);
               begin
                  if Hit /= "" then
                     return Hit;
                  end if;
               end;
            end if;
            Cut := Cut - 1;
         end loop;

         return "";
      end Walk;

      Rows : constant String := Relative_Pattern_Row (Locale);
      Exact : constant String := Search (Rows, Category);
   begin
      if Exact /= "" then
         return Exact;
      end if;

      --  The wanted category over the locale, then the wider
      --  "other", and only then the same two over its parents.
      if Category /= "other" then
         declare
            Other_Exact : constant String := Search (Rows, "other");
         begin
            if Other_Exact /= "" then
               return Other_Exact;
            end if;
         end;
      end if;

      declare
         Fallback_Result : constant String := Walk (Category);
      begin
         if Fallback_Result /= "" then
            return Fallback_Result;
         end if;
      end;

      if Category /= "other" then
         return Walk ("other");
      end if;

      return "";
   end Relative_Time_Pattern;

   function Relative_Unit_Display_Name
     (Locale   : String;
      Base     : String;
      Singular : Boolean)
      return String
   is
      Lang : constant String := Language (Locale);
   begin
      if Lang /= "ru" and then Lang /= "uk" and then Lang /= "pl" then
         declare
            Generated : constant String :=
              Relative_Unit_Category_Name
                (Locale, Base, (if Singular then "one" else "other"));
         begin
            if Generated /= "" then
               return Generated;
            end if;
         end;
      end if;

      if Lang = "ro" then
         if Base = "day" then
            return (if Singular then "zi" else "zile");
         elsif Base = "week" then
            return
              (if Singular
               then "s" & U (16#103#) & "pt"
                    & U (16#103#) & "m" & U (16#E2#)
                    & "n" & U (16#103#)
               else "s" & U (16#103#) & "pt"
                    & U (16#103#) & "m" & U (16#E2#) & "ni");
         elsif Base = "month" then
            return (if Singular then "lun" & U (16#103#) else "luni");
         elsif Base = "year" then
            return (if Singular then "an" else "ani");
         end if;
      elsif Lang = "lt" then
         if Base = "day" then
            return (if Singular then "dien" & U (16#105#) else "dienas");
         elsif Base = "week" then
            return (if Singular then "savait" & U (16#119#) else "savaites");
         elsif Base = "month" then
            return
              (if Singular
               then "m" & U (16#117#) & "nes" & U (16#12F#)
               else "m" & U (16#117#) & "nesius");
         elsif Base = "year" then
            return "metus";
         end if;
      elsif Lang = "sl" then
         if Base = "day" then
            return (if Singular then "dan" else "dnevi");
         elsif Base = "week" then
            return (if Singular then "teden" else "tedni");
         elsif Base = "month" then
