            when others => return [1 => Digit];
         end case;
         elsif Contains (Locale, "-u-nu-tirh")
           or else Contains (Locale, "@numbers=tirh")
         then
         case Digit is
            when '0' => return U (16#114D0#);
            when '1' => return U (16#114D1#);
            when '2' => return U (16#114D2#);
            when '3' => return U (16#114D3#);
