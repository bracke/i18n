   function Time_Zone_Offset_Separator (Locale : String) return String is
   begin
      if Locale_Equals (Locale, "da") then
         return ".";
      elsif Locale_Equals (Locale, "da-GL") then
         return ".";
      elsif Locale_Equals (Locale, "fi") then
         return ".";
      elsif Locale_Equals (Locale, "id") then
         return ".";
      elsif Locale_Equals (Locale, "ms-ID") then
         return ".";
      elsif Locale_Equals (Locale, "nds") then
         return ".";
      elsif Locale_Equals (Locale, "nds-NL") then
         return ".";
      elsif Locale_Equals (Locale, "si") then
         return ".";
      elsif Locale_Equals (Locale, "sl") then
         return ".";
      end if;

      if Locale_Fallback_Matches (Locale, "da") then
         return ".";
      elsif Locale_Fallback_Matches (Locale, "da-GL") then
         return ".";
      elsif Locale_Fallback_Matches (Locale, "fi") then
         return ".";
      elsif Locale_Fallback_Matches (Locale, "id") then
         return ".";
      elsif Locale_Fallback_Matches (Locale, "ms-ID") then
         return ".";
      elsif Locale_Fallback_Matches (Locale, "nds") then
         return ".";
      elsif Locale_Fallback_Matches (Locale, "nds-NL") then
         return ".";
      elsif Locale_Fallback_Matches (Locale, "si") then
         return ".";
      elsif Locale_Fallback_Matches (Locale, "sl") then
         return ".";
      end if;

      return ":";
   end Time_Zone_Offset_Separator;

