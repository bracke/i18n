            when '7' => return U (16#16AC7#);
            when '8' => return U (16#16AC8#);
            when '9' => return U (16#16AC9#);
            when others => return [1 => Digit];
         end case;
         elsif Contains (Locale, "-u-nu-tols")
           or else Contains (Locale, "@numbers=tols")
         then
         case Digit is
            when '0' => return U (16#11DE0#);
            when '1' => return U (16#11DE1#);
            when '2' => return U (16#11DE2#);
            when '3' => return U (16#11DE3#);
            when '4' => return U (16#11DE4#);
            when '5' => return U (16#11DE5#);
            when '6' => return U (16#11DE6#);
            when '7' => return U (16#11DE7#);
            when '8' => return U (16#11DE8#);
            when '9' => return U (16#11DE9#);
            when others => return [1 => Digit];
         end case;
         elsif Contains (Locale, "-u-nu-vaii")
           or else Contains (Locale, "@numbers=vaii")
         then
         case Digit is
            when '0' => return U (16#A620#);
            when '1' => return U (16#A621#);
            when '2' => return U (16#A622#);
            when '3' => return U (16#A623#);
            when '4' => return U (16#A624#);
            when '5' => return U (16#A625#);
            when '6' => return U (16#A626#);
            when '7' => return U (16#A627#);
            when '8' => return U (16#A628#);
            when '9' => return U (16#A629#);
            when others => return [1 => Digit];
         end case;
         elsif Contains (Locale, "-u-nu-wara")
           or else Contains (Locale, "@numbers=wara")
         then
         case Digit is
            when '0' => return U (16#118E0#);
            when '1' => return U (16#118E1#);
            when '2' => return U (16#118E2#);
            when '3' => return U (16#118E3#);
            when '4' => return U (16#118E4#);
            when '5' => return U (16#118E5#);
            when '6' => return U (16#118E6#);
            when '7' => return U (16#118E7#);
            when '8' => return U (16#118E8#);
            when '9' => return U (16#118E9#);
            when others => return [1 => Digit];
         end case;
         elsif Contains (Locale, "-u-nu-wcho")
           or else Contains (Locale, "@numbers=wcho")
         then
         case Digit is
            when '0' => return U (16#1E2F0#);
            when '1' => return U (16#1E2F1#);
            when '2' => return U (16#1E2F2#);
            when '3' => return U (16#1E2F3#);
            when '4' => return U (16#1E2F4#);
            when '5' => return U (16#1E2F5#);
            when '6' => return U (16#1E2F6#);
            when '7' => return U (16#1E2F7#);
            when '8' => return U (16#1E2F8#);
            when '9' => return U (16#1E2F9#);
            when others => return [1 => Digit];
         end case;
         end if;
      end if;

      if Lang = "bn" then
         case Digit is
            when '0' => return U (16#9E6#);
            when '1' => return U (16#9E7#);
            when '2' => return U (16#9E8#);
            when '3' => return U (16#9E9#);
            when '4' => return U (16#9EA#);
            when '5' => return U (16#9EB#);
            when '6' => return U (16#9EC#);
            when '7' => return U (16#9ED#);
            when '8' => return U (16#9EE#);
            when '9' => return U (16#9EF#);
            when others => return [1 => Digit];
         end case;
      end if;

      declare
         Row : constant String := Digit_Row (Locale);
      begin
         --  Digit_Row is decoded by its own Value_At, so Row is
         --  already the forty bytes: ten digits of four.
         if Row'Length = 40 and then Digit in '0' .. '9' then
            declare
               Base : constant Natural :=
                 Row'First
                   + (Character'Pos (Digit)
                      - Character'Pos ('0')) * 4;
               Stop : Natural := Base + 3;
            begin
               while Stop >= Base
                 and then Row (Stop) = Character'Val (0)
               loop
                  Stop := Stop - 1;
               end loop;
               return Row (Base .. Stop);
            end;
         end if;

         return [1 => Digit];
      end;
   end Digit_Text;

   function Number_Compact_Suffix
     (Locale    : String;
      Scale     : Long_Long_Integer;
      Long_Form : Boolean)
      return String
   is
      Lang : constant String := Language (Locale);
   begin
      if Lang = "ja" or else Lang = "zh" then
         if Scale = 10_000 then
            return U (16#4E07#);
         elsif Scale = 100_000_000 then
            return U (16#5104#);
         elsif Scale = 1_000_000_000_000 then
            return U (16#5146#);
         else
            return "";
         end if;
      elsif Lang = "ko" then
         if Scale = 10_000 then
            return U (16#B9CC#);
         elsif Scale = 100_000_000 then
            return U (16#C5B5#);
         elsif Scale = 1_000_000_000_000 then
            return U (16#C870#);
         else
            return "";
         end if;
      end if;

      if Long_Form then
         if Scale = 1_000 then
            return " thousand";
         elsif Scale = 1_000_000 then
            return " million";
         elsif Scale = 1_000_000_000 then
            return " billion";
         elsif Scale = 1_000_000_000_000 then
            return " trillion";
         else
            return "";
         end if;
      else
         if Scale = 1_000 then
            return "K";
         elsif Scale = 1_000_000 then
            return "M";
         elsif Scale = 1_000_000_000 then
            return "B";
         elsif Scale = 1_000_000_000_000 then
            return "T";
         else
            return "";
         end if;
      end if;
   end Number_Compact_Suffix;

   function Era_Name
     (Locale   : String;
      Calendar : String;
      Era      : String)
      return String
   is
      Lang : constant String := Language (Locale);
   begin
      if Calendar = "gregorian" and then Era = "ad" then
         if Lang = "de" then
            return "n. Chr.";
         elsif Lang = "fr" then
            return "ap. J.-C.";
         elsif Lang = "es" then
            return "d. C.";
         elsif Lang = "it" then
            return "d.C.";
         elsif Lang = "pt" then
            return "d.C.";
         elsif Lang = "nl" then
            return "n.Chr.";
         elsif Lang = "ro" then
            return "d.Hr.";
         elsif Lang = "lt" then
            return "po Kr.";
         elsif Lang = "sl" then
            return "po Kr.";
         elsif Lang = "pl" then
            return "n.e.";
         elsif Lang = "cs" then
            return "n. l.";
         elsif Lang = "ru" then
            return U (16#43D#) & ". " & U (16#44D#) & ".";
         elsif Lang = "ar" then
            return U (16#645#);
         elsif Lang = "ja" then
            return U (16#897F#) & U (16#66A6#);
         elsif Lang = "zh" then
            return U (16#516C#) & U (16#5143#);
         elsif Lang = "ko" then
            return U (16#C11C#) & U (16#AE30#);
         else
            return "AD";
         end if;
      elsif Calendar = "japanese" and then Era = "reiwa" then
         return
           (if Lang = "ja"
            then U (16#4EE4#) & U (16#548C#)
            else "Reiwa");
      elsif Calendar = "japanese" and then Era = "heisei" then
         return
           (if Lang = "ja"
            then U (16#5E73#) & U (16#6210#)
            else "Heisei");
      elsif Calendar = "japanese" and then Era = "showa" then
         return
           (if Lang = "ja"
            then U (16#662D#) & U (16#548C#)
            else "Showa");
      elsif Calendar = "japanese" and then Era = "taisho" then
         return
           (if Lang = "ja"
            then U (16#5927#) & U (16#6B63#)
            else "Taisho");
      elsif Calendar = "japanese" and then Era = "meiji" then
         return
           (if Lang = "ja"
            then U (16#660E#) & U (16#6CBB#)
            else "Meiji");
      elsif Calendar = "japanese" and then Era = "keio" then
         return
           (if Lang = "ja"
            then U (16#6176#) & U (16#5FDC#)
            else "Keio");
      elsif Calendar = "roc" and then Era = "minguo" then
         return
           (if Lang = "zh"
            then U (16#6C11#) & U (16#570B#)
            else "Minguo");
      else
         return "";
      end if;
   end Era_Name;

   function Era_Year_Separator
     (Locale   : String;
      Calendar : String)
      return String
   is
      pragma Unreferenced (Locale, Calendar);
   begin
      return " ";
   end Era_Year_Separator;

