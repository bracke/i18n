      Link_Width : constant := 32;
      Width : constant := Link_Width + 10;
      Count : constant Natural := Index_Data'Length / Width;

      function Key (N : Positive) return String is
        (Index_Data (Index_Data'First + (N - 1) * Width ..
                     Index_Data'First + (N - 1) * Width + Link_Width - 1));

      function Value_At (N : Positive) return String is
         Base : constant Natural :=
           Index_Data'First + (N - 1) * Width + Link_Width;
         F : constant Natural :=
           N62 (Index_Data (Base .. Base + 4));
         T : constant Natural :=
           N62 (Index_Data (Base + 5 .. Base + 9));
      begin
         return Values (F .. T);
      end Value_At;

      Low : Natural := 1;
      High : Natural := Count;
      Mid : Natural;
   begin
      if Zone = ""
        or else Zone = "UTC"
        or else Zone = "UCT"
        or else Zone = "Universal"
        or else Zone = "Zulu"
        or else Zone = "Etc/UTC"
        or else Zone = "Etc/UCT"
        or else Zone = "Etc/Universal"
        or else Zone = "Etc/Zulu"
      then
         return "UTC";
      end if;

      if Zone = "GMT" then
         return "GMT";
      end if;

      if Zone'Length <= Link_Width then
         declare
            Wanted : constant String :=
              Zone & [1 .. Link_Width - Zone'Length => ' '];
         begin
            while Low <= High loop
               Mid := (Low + High) / 2;
               if Key (Mid) = Wanted then
                  return Value_At (Mid);
               elsif Key (Mid) < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end loop;
         end;
      end if;
      return Zone;
   end Canonical_Time_Zone;


