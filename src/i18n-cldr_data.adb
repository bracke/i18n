      Index_Width : constant := 28;
      Index_Count : constant Natural :=
        Index_Data'Length / Index_Width;

      function Index_Key (N : Positive) return String is
        (Index_Data (Index_Data'First + (N - 1) * Index_Width ..
                     Index_Data'First + (N - 1) * Index_Width + 13));

      function Padded (Cand : String) return String is
        (if Cand'Length >= 14 then Cand (Cand'First .. Cand'First + 13)
         else Cand & (1 .. 14 - Cand'Length => ' '));

      procedure Segment
        (Cand      : String;
         Canonical : Boolean;
         First     : out Natural;
         Last      : out Natural)
      is
         Low  : Natural := 1;
         High : Natural := Index_Count;
         Mid  : Natural;

         procedure Take (N : Positive) is
            Base : constant Natural :=
              Index_Data'First + (N - 1) * Index_Width + 14;
         begin
            First := Natural'Value (Index_Data (Base .. Base + 6));
            Last := Natural'Value (Index_Data (Base + 7 .. Base + 13));
         end Take;
