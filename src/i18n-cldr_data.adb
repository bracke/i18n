6yue-hant      0030121100302696yue-hant-cn   0030121100302696yue-hant-mo   0030121100302696za            0000000100001336zgh           0000277300004136zh            0030269700304100zh-hans       0030269700304100zh-hans-hk    0030410100305538zh-hans-mo    0030553900306976zh-hans-my    0030269700304100zh-hans-sg    0030697700308430zh-hant       0030121100302696zh-hant-hk    0030843100309810zh-hant-mo    0030843100309810zh-hant-my    0030121100302696zh-latn       0000000100001336zu            0030981100311150";
      Width : constant := 30;
      Count : constant Natural := Index_Data'Length / Width;

      function Key (N : Positive) return String is
        (Index_Data (Index_Data'First + (N - 1) * Width ..
                     Index_Data'First + (N - 1) * Width + 13));

      function Padded (Cand : String) return String is
        (if Cand'Length >= 14 then Cand (Cand'First .. Cand'First + 13)
         else Cand & (1 .. 14 - Cand'Length => ' '));

      function Value_At (N : Positive) return String is
         Base : constant Natural :=
           Index_Data'First + (N - 1) * Width + 14;
         F : constant Natural :=
           Natural'Value (Index_Data (Base .. Base + 7));
         T : constant Natural :=
           Natural'Value (Index_Data (Base + 8 .. Base + 15));
      begin
         return Values (F .. T);
      end Value_At;

      --  Keys are stored canonical, so canonicalise once and
      --  bisect. Nothing walks: a locale the table does not hold
      --  costs the same handful of comparisons as one it does.
      function Lookup (Cand : String) return String is
         Low : Natural := 1;
         High : Natural := Count;
         Mid : Natural;
      begin
         if Cand'Length = 0 or else Count = 0 then
            return "";
         end if;

         declare
            Wanted : constant String :=
              Padded (Canonical_Locale (Cand));
         begin
            while Low <= High loop
               Mid := (Low + High) / 2;
               if Key (Mid) = Wanted then
                  return Value_At (Mid);
               elsif Key (Mid) < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end loop;
         end;
         return "";
      end Lookup;

      Exact : constant String := Lookup (Locale);
   begin
      if Exact /= "" then
         return Exact;
      end if;

      return "";
   end Date_Style_Row;

   --  CLDR's own dateFormats, by locale and calendar. The heuristic
   --  below is the fallback for locales outside the pinned subset:
   --  it can only choose between a day-month-year and a
   --  month-day-year shape, which is not what every locale writes.
   function Date_Style_Pattern
     (Locale   : String;
      Calendar : String;
      Style    : String)
      return String
   is
      Lang : constant String := Language (Locale);
      DMY : constant Boolean := Uses_Day_Month_Year (Locale);

      --  calendar|style|pattern, one run per locale. A calendar
      --  the locale does not carry falls back to gregorian, which
      --  is why the scan finishes the segment before answering.
      function Cal_Code (Want : String) return String is
        (if Want = "buddhist" then "a"
         elsif Want = "coptic" then "b"
         elsif Want = "ethiopic" then "c"
         elsif Want = "gregorian" then "d"
         elsif Want = "hebrew" then "e"
         elsif Want = "indian" then "f"
         elsif Want = "japanese" then "g"
         elsif Want = "persian" then "h"
         elsif Want = "roc" then "i"
         else " ");

      function Style_Code return String is
        (if Style = "full" then "a"
         elsif Style = "long" then "b"
         elsif Style = "medium" then "c"
         elsif Style = "short" then "d"
         else " ");

      Gregorian_Code : constant String := "d";

      --  calendar and style as one coded character each, then the
      --  hex. A calendar the locale does not carry falls back to
      --  gregorian, so the scan finishes before answering.
      function In_Rows (Rows : String; Wanted_Calendar : String)
         return String
      is
         Start : Positive := Rows'First;
         Fallback_First : Natural := 0;
         Fallback_Last : Natural := 0;
         Wanted : constant String := Cal_Code (Wanted_Calendar);
         Styled : constant String := Style_Code;
      begin
         if Styled = " " then
            return "";
         end if;

         while Start <= Rows'Last loop
            declare
               Stop : Natural := Rows'Last + 1;
            begin
               for Index in Start .. Rows'Last loop
                  if Rows (Index) = '~' then
                     Stop := Index;
                     exit;
                  end if;
               end loop;

               exit when Stop <= Start + 2;
               if Rows (Start + 1) = Styled (Styled'First) then
                  declare
                     Cal : constant String := Rows (Start .. Start);
                  begin
                     if Cal = Wanted then
                        return HB (Rows (Start + 2 .. Stop - 1));
                     elsif Cal = Gregorian_Code then
                        Fallback_First := Start + 2;
                        Fallback_Last := Stop - 1;
                     end if;
                  end;
               end if;

               Start := Stop + 1;
            end;
         end loop;

         if Fallback_First /= 0 then
            return HB (Rows (Fallback_First .. Fallback_Last));
         end if;
         return "";
      end In_Rows;

      --  The locale, then each parent, longest first.
      function Search (Wanted_Calendar : String) return String is
         Canon : constant String := Canonical_Locale (Locale);
         Cut : Natural := Canon'Last;
         Exact : constant String :=
           In_Rows (Date_Style_Row (Locale), Wanted_Calendar);
      begin
         if Exact /= "" then
            return Exact;
         end if;

         while Cut > Canon'First loop
            if Canon (Cut) = '-' then
               declare
                  Hit : constant String :=
                    In_Rows
                      (Date_Style_Row (Canon (Canon'First .. Cut - 1)),
                       Wanted_Calendar);
               begin
                  if Hit /= "" then
                     return Hit;
                  end if;
               end;
            end if;
            Cut := Cut - 1;
         end loop;

         return "";
      end Search;

      Effective_Calendar : constant String :=
        (if Calendar = "" then "gregorian" else Calendar);
      Found : constant String := Search (Effective_Calendar);
   begin
      if Found /= "" then
         return Found;
      end if;

      --  Outside the pinned subset, fall back to the old shape rule.
      if In_List (Lang, "ja,zh") then
         if Style = "short" then
            return "yy'/'M'/'d";
         elsif Style = "full" then
            return "y'" & U (16#5E74#) & "'M'" & U (16#6708#) & "'d'" & U (16#65E5#) & "'EEEE";
         else
            return "y'" & U (16#5E74#) & "'M'" & U (16#6708#) & "'d'" & U (16#65E5#) & "'";
         end if;
      elsif Lang = "ko" then
         if Style = "short" then
            return "yy'/'M'/'d";
         elsif Style = "full" then
            return "y'" & U (16#B144#) & " 'M'" & U (16#C6D4#) & " 'd'" & U (16#C77C#) & " 'EEEE";
         else
            return "y'" & U (16#B144#) & " 'M'" & U (16#C6D4#) & " 'd'" & U (16#C77C#) & "'";
         end if;
      elsif DMY then
         if Style = "short" then
            return "dd'.'MM'.'yy";
         elsif Style = "long" or else Style = "full" then
            if Style = "full" then
               return "EEEE', 'd'. 'MMMM' 'yyyy";
            else
               return "d'. 'MMMM' 'yyyy";
            end if;
         else
            return "dd'.'MM'.'yyyy";
         end if;
      else
         if Style = "short" then
            return "M'/'d'/'yy";
         elsif Style = "long" or else Style = "full" then
            if Style = "full" then
               return "EEEE', 'MMMM' 'd', 'yyyy";
            else
               return "MMMM' 'd', 'yyyy";
            end if;
         elsif Style = "medium" then
            return "MMMM' 'd', 'yyyy";
         else
            return "yyyy'-'MM'-'dd";
         end if;
      end if;
   end Date_Style_Pattern;

   function Date_Style_Pattern
     (Locale : String;
      Style  : String)
      return String is
   begin
      return Date_Style_Pattern (Locale, "gregorian", Style);
   end Date_Style_Pattern;

   function Time_Style_Pattern
     (Locale     : String;
      Style      : String;
      Has_Second : Boolean)
      return String
   is
      Lang : constant String := Language (Locale);
   begin
      if Lang = "ko" then
         if Style = "long" or else Style = "full" then
            return "ah':'mm':'ss";
         elsif Style = "" or else Style = "medium" then
            return (if Has_Second then "ah':'mm':'ss" else "ah':'mm");
         else
            return "ah':'mm";
         end if;
      elsif Style = "long" or else Style = "full" then
         return "HH':'mm':'ss";
      elsif Style = "" or else Style = "medium" then
         return (if Has_Second then "HH':'mm':'ss" else "HH':'mm");
      else
         return "HH':'mm";
      end if;
   end Time_Style_Pattern;

