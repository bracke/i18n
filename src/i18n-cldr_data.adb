      Width : constant := 30;
      Count : constant Natural := Index_Data'Length / Width;

      function Key (N : Positive) return String is
        (Index_Data (Index_Data'First + (N - 1) * Width ..
                     Index_Data'First + (N - 1) * Width + 13));

      function Padded (Cand : String) return String is
        (if Cand'Length >= 14 then Cand (Cand'First .. Cand'First + 13)
         else Cand & (1 .. 14 - Cand'Length => ' '));

      function Value_At (N : Positive) return String is
         Base : constant Natural :=
           Index_Data'First + (N - 1) * Width + 14;
         F : constant Natural :=
           Natural'Value (Index_Data (Base .. Base + 7));
         T : constant Natural :=
           Natural'Value (Index_Data (Base + 8 .. Base + 15));
      begin
         return Values (F .. T);
      end Value_At;

      function Lookup (Cand : String; Canonical : Boolean) return String is
         Low : Natural := 1;
         High : Natural := Count;
         Mid : Natural;
      begin
         if Cand'Length = 0 or else Count = 0 then
            return "";
         end if;

         if Canonical then
            --  A locale spelled some other way does not sort where
            --  its canonical form would, so this one is a walk.
            for N in 1 .. Count loop
               declare
                  K : constant String := Key (N);
                  Stop : Natural := K'Last;
               begin
                  while Stop >= K'First and then K (Stop) = ' ' loop
                     Stop := Stop - 1;
                  end loop;
                  if Locale_Equals (Cand, K (K'First .. Stop)) then
                     return Value_At (N);
                  end if;
               end;
            end loop;
            return "";
         end if;

         declare
            Wanted : constant String := Padded (Cand);
         begin
            while Low <= High loop
               Mid := (Low + High) / 2;
               if Key (Mid) = Wanted then
                  return Value_At (Mid);
               elsif Key (Mid) < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end loop;
         end;
         return "";
      end Lookup;

      --  Bisect on the spelling as written, which answers almost
      --  every call; only a caller who spelled it some other way
      --  ("DE_at") pays for the walk.
      function Resolve (Cand : String) return String is
         Hit : constant String := Lookup (Cand, False);
      begin
         if Hit /= "" then
            return Hit;
         end if;
         return Lookup (Cand, True);
      end Resolve;

      Exact : constant String := Resolve (Locale);
   begin
      if Exact /= "" then
         return Exact;
      end if;

      return "";
   end Relative_Pattern_Row;

   function Relative_Time_Pattern
     (Locale   : String;
      Base     : String;
      Width    : String;
      Category : String;
      Future   : Boolean)
      return String
   is
      Direction : constant String :=
        (if Future then "future" else "past");

      function Search (Rows : String; Wanted : String) return String is
         Start : Positive := Rows'First;
      begin
         while Start <= Rows'Last loop
            declare
               Sep1 : Natural := 0;
               Sep2 : Natural := 0;
               Sep3 : Natural := 0;
               Sep4 : Natural := 0;
               Stop : Natural := Rows'Last + 1;
            begin
               for Index in Start .. Rows'Last loop
                  if Rows (Index) = '|' then
                     if Sep1 = 0 then
                        Sep1 := Index;
                     elsif Sep2 = 0 then
                        Sep2 := Index;
                     elsif Sep3 = 0 then
                        Sep3 := Index;
                     elsif Sep4 = 0 then
                        Sep4 := Index;
                     end if;
                  elsif Rows (Index) = '~' then
                     Stop := Index;
                     exit;
                  end if;
               end loop;

               if Sep4 /= 0
                 and then Sep1 > Start
                 and then Sep2 > Sep1 + 1
                 and then Sep3 > Sep2 + 1
                 and then Sep4 > Sep3 + 1
                 and then Stop > Sep4 + 1
                 and then Rows (Start .. Sep1 - 1) = Base
                 and then Rows (Sep1 + 1 .. Sep2 - 1) = Width
                 and then Rows (Sep2 + 1 .. Sep3 - 1) = Direction
                 and then Rows (Sep3 + 1 .. Sep4 - 1) = Wanted
               then
                  return HB (Rows (Sep4 + 1 .. Stop - 1));
               end if;

               Start := Stop + 1;
            end;
         end loop;

         return "";
      end Search;

      --  Each parent in turn, longest first.
      function Walk (Wanted : String) return String is
         Canon : constant String := Canonical_Locale (Locale);
         Cut : Natural := Canon'Last;
      begin
         while Cut > Canon'First loop
            if Canon (Cut) = '-' then
               declare
                  Rows : constant String :=
                    Relative_Pattern_Row (Canon (Canon'First .. Cut - 1));
                  Hit : constant String := Search (Rows, Wanted);
               begin
                  if Hit /= "" then
                     return Hit;
                  end if;
               end;
            end if;
            Cut := Cut - 1;
         end loop;

         return "";
      end Walk;

      Rows : constant String := Relative_Pattern_Row (Locale);
      Exact : constant String := Search (Rows, Category);
   begin
      if Exact /= "" then
         return Exact;
      end if;

      --  The wanted category over the locale, then the wider
      --  "other", and only then the same two over its parents.
      if Category /= "other" then
         declare
            Other_Exact : constant String := Search (Rows, "other");
         begin
            if Other_Exact /= "" then
               return Other_Exact;
            end if;
         end;
      end if;

      declare
         Fallback_Result : constant String := Walk (Category);
      begin
         if Fallback_Result /= "" then
            return Fallback_Result;
         end if;
      end;

      if Category /= "other" then
         return Walk ("other");
      end if;

      return "";
   end Relative_Time_Pattern;

