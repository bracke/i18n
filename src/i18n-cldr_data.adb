   function TZDB_Key
     (Year   : Natural;
      Month  : Natural;
      Day    : Natural;
      Hour   : Natural;
      Minute : Natural;
      Second : Natural)
      return Long_Long_Integer
   is
   begin
      return (((((Long_Long_Integer (Year) * 100
                 + Long_Long_Integer (Month)) * 100
                + Long_Long_Integer (Day)) * 100
               + Long_Long_Integer (Hour)) * 100
              + Long_Long_Integer (Minute)) * 100
             + Long_Long_Integer (Second));
   end TZDB_Key;

   function Time_Zone_Offset_Seconds_At_UTC
     (Zone   : String;
      Year   : Natural;
      Month  : Natural;
      Day    : Natural;
      Hour   : Natural;
      Minute : Natural;
      Second : Natural;
      Valid  : out Boolean)
      return Integer
   is
      Index : constant Natural := Time_Zone_TZDB_Index (Zone);
   begin
      if Zone = ""
        or else Zone = "UTC"
        or else Zone = "Z"
        or else Zone = "GMT"
        or else Zone = "Etc/UTC"
        or else Zone = "Etc/GMT"
      then
         Valid := True;
         return 0;
      elsif Index = 0 then
         Valid := False;
         return 0;
      else
         declare
            Key : constant Long_Long_Integer :=
              TZDB_Key (Year, Month, Day, Hour, Minute, Second);
            First : constant Natural := TZDB_Zones (Index).First;
            Last  : constant Natural := TZDB_Zones (Index).Last;
         begin
            Valid := True;
            if First = 0 then
               return TZDB_Zones (Index).Initial_Offset;
            end if;

            for Transition_Index in reverse First .. Last loop
               if TZDB_Transitions (Transition_Index).Key <= Key then
                  return TZDB_Transitions (Transition_Index).Offset;
               end if;
            end loop;

            return TZDB_Zones (Index).Initial_Offset;
         end;
      end if;
   end Time_Zone_Offset_Seconds_At_UTC;

   function Time_Zone_Base_Offset_Minutes
     (Zone  : String;
      Valid : out Boolean)
      return Integer
   is
   begin
      Valid := True;

      if Zone = ""
        or else Zone = "UTC"
        or else Zone = "Z"
        or else Zone = "GMT"
        or else Zone = "Etc/UTC"
        or else Zone = "Etc/GMT"
      then
         return 0;
      elsif Zone = "Europe/Berlin"
        or else Zone = "Europe/Paris"
        or else Zone = "Europe/Rome"
        or else Zone = "Europe/Madrid"
        or else Zone = "Europe/Amsterdam"
        or else Zone = "Europe/Zurich"
        or else Zone = "Europe/Vienna"
        or else Zone = "Europe/Brussels"
        or else Zone = "Europe/Copenhagen"
        or else Zone = "Europe/Stockholm"
        or else Zone = "Europe/Oslo"
        or else Zone = "Europe/Warsaw"
        or else Zone = "Europe/Prague"
        or else Zone = "Europe/Budapest"
        or else Zone = "Europe/Bratislava"
        or else Zone = "Europe/Luxembourg"
        or else Zone = "Europe/Monaco"
        or else Zone = "Europe/Andorra"
        or else Zone = "Europe/Malta"
        or else Zone = "Europe/San_Marino"
        or else Zone = "Europe/Vatican"
        or else Zone = "Europe/Belgrade"
        or else Zone = "Europe/Zagreb"
        or else Zone = "Europe/Ljubljana"
