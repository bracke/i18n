         return "PiB";
      elsif Scale = 1_099_511_627_776 then
         return "TiB";
      elsif Scale = 1_073_741_824 then
         return "GiB";
      elsif Scale = 1_048_576 then
         return "MiB";
      elsif Scale = 1_024 then
         return "KiB";
      elsif Scale = 1 then
         return "B";
      else
         return "";
      end if;
   end Byte_Size_Unit_Label;

