   function Canonical_Locale (Locale : String) return String is
      Buffer : String (1 .. 64) := [others => Character'Val (0)];
      Last   : Natural := 0;
   begin
      for C of Locale loop
         exit when Last = Buffer'Last;
         if C = '_' then
            Last := Last + 1;
            Buffer (Last) := '-';
         else
            Last := Last + 1;
            Buffer (Last) := Lower (C);
         end if;
      end loop;

      if Last = 0 then
         return "";
      else
         return Buffer (1 .. Last);
      end if;
