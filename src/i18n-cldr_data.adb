         elsif Family /= "none" then
            return UTF8 ([16#533A#, 16#57DF#, 16#65F6#,
              16#95F4#]);
         end if;
      elsif Lang = "ko" then
         if Family = "europe-central" then
            return UTF8 ([16#C911#, 16#C559#, 16#20#,
              16#C720#, 16#B7FD#, 16#20#, 16#C2DC#,
              16#AC04#]);
