        & "070414xh            0000000100000065xnr           0007041500070659xog   "
        & "        0007066000070756yav           0007075700070897yi            0007"
        & "089800071114yo            0007111500071239yo-BJ         0007124000071356"
        & "yrl           0007135700072003yrl-CO        0007200400072686yrl-VE      "
        & "  0007200400072686yue           0007268700073088yue-Hans      0007308900"
        & "073490yue-Hant      0007268700073088yue-Hant-CN   0007268700073088yue-Ha"
        & "nt-MO   0007268700073088za            0007349100073585zgh           0005"
        & "567200055888zh            0007358600073987zh-Hans       0007358600073987"
        & "zh-Hans-HK    0007358600073987zh-Hans-MO    0007358600073987zh-Hans-MY  "
        & "  0007358600073987zh-Hans-SG    0007358600073987zh-Hant       0007398800"
        & "074389zh-Hant-HK    0007439000074791zh-Hant-MO    0007439000074791zh-Han"
        & "t-MY    0007398800074389zh-Latn       0000000100000065zu            0007"
        & "479200075128";
      Width : constant := 30;
      Count : constant Natural := Index_Data'Length / Width;

      function Key (N : Positive) return String is
        (Index_Data (Index_Data'First + (N - 1) * Width ..
                     Index_Data'First + (N - 1) * Width + 13));

      function Padded (Cand : String) return String is
        (if Cand'Length >= 14 then Cand (Cand'First .. Cand'First + 13)
         else Cand & (1 .. 14 - Cand'Length => ' '));

      function Value_At (N : Positive) return String is
         Base : constant Natural :=
           Index_Data'First + (N - 1) * Width + 14;
         F : constant Natural :=
           Natural'Value (Index_Data (Base .. Base + 7));
         T : constant Natural :=
           Natural'Value (Index_Data (Base + 8 .. Base + 15));
      begin
         return Values (F .. T);
      end Value_At;

      function Lookup (Cand : String; Canonical : Boolean) return String is
         Low : Natural := 1;
         High : Natural := Count;
         Mid : Natural;
      begin
         if Cand'Length = 0 or else Count = 0 then
            return "";
         end if;

         if Canonical then
            --  A locale spelled some other way does not sort where
            --  its canonical form would, so this one is a walk.
            for N in 1 .. Count loop
               declare
                  K : constant String := Key (N);
                  Stop : Natural := K'Last;
               begin
                  while Stop >= K'First and then K (Stop) = ' ' loop
                     Stop := Stop - 1;
                  end loop;
                  if Locale_Equals (Cand, K (K'First .. Stop)) then
                     return Value_At (N);
                  end if;
               end;
            end loop;
            return "";
         end if;

         declare
            Wanted : constant String := Padded (Cand);
         begin
            while Low <= High loop
               Mid := (Low + High) / 2;
               if Key (Mid) = Wanted then
                  return Value_At (Mid);
               elsif Key (Mid) < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end loop;
         end;
         return "";
      end Lookup;

      --  Bisect on the spelling as written, which answers almost
      --  every call; only a caller who spelled it some other way
      --  ("DE_at") pays for the walk.
      function Resolve (Cand : String) return String is
         Hit : constant String := Lookup (Cand, False);
      begin
         if Hit /= "" then
            return Hit;
         end if;
         return Lookup (Cand, True);
      end Resolve;

      --  Parents are cut from the canonical spelling: "de_AT" has
      --  no '-' to cut, and would otherwise lose its fallback.
      Canon : constant String := Canonical_Locale (Locale);
      Exact : constant String := Resolve (Locale);
      Cut : Natural := Canon'Last;
   begin
      if Exact /= "" then
         return Exact;
      end if;

      --  Then each parent, which is what the fallback pass did.
      while Cut > Canon'First loop
         if Canon (Cut) = '-' then
            declare
               Hit : constant String :=
                 Resolve (Canon (Canon'First .. Cut - 1));
            begin
               if Hit /= "" then
                  return Hit;
               end if;
            end;
         end if;
         Cut := Cut - 1;
      end loop;

      return "";
   end Day_Period_Row;

   function Day_Period_Name
     (Locale : String;
      Period : String;
      Wide   : Boolean)
      return String
   is
      Lang : constant String := Language (Locale);
      Row : constant String := Day_Period_Row (Locale);
   begin
      if Row /= "" then
         declare
            Value : constant String :=
              Day_Period_Payload_Value
                (Row, Period, (if Wide then "wide" else "abbreviated"));
         begin
            if Value /= "" then
               return Value;
            end if;
         end;
      end if;

      if Lang = "de" then
         if Period = "midnight" then
            return (if Wide then "Mitternacht" else "Mittern.");
         elsif Period = "noon" then
            return "Mittag";
         elsif Period = "am" then
            return (if Wide then "vormittags" else "vorm.");
         elsif Period = "pm" then
            return (if Wide then "nachmittags" else "nachm.");
         end if;
      elsif Lang = "fr" then
         if Period = "midnight" then
            return "minuit";
         elsif Period = "noon" then
            return "midi";
         elsif Period = "am" then
            return "AM";
         elsif Period = "pm" then
            return "PM";
         end if;
      elsif Lang = "es" then
         if Period = "midnight" then
            return "medianoche";
         elsif Period = "noon" then
            return "mediod" & U (16#ED#) & "a";
         elsif Period = "am" then
            return "a. m.";
         elsif Period = "pm" then
            return "p. m.";
         end if;
      elsif Lang = "it" then
         if Period = "midnight" then
            return "mezzanotte";
         elsif Period = "noon" then
            return "mezzogiorno";
         elsif Period = "am" then
            return "AM";
         elsif Period = "pm" then
            return "PM";
         end if;
      elsif Lang = "pt" then
         if Period = "midnight" then
            return "meia-noite";
         elsif Period = "noon" then
            return "meio-dia";
         elsif Period = "am" then
            return "AM";
         elsif Period = "pm" then
            return "PM";
         end if;
      elsif Lang = "nl" then
         if Period = "midnight" then
            return "middernacht";
         elsif Period = "noon" then
            return "middag";
         elsif Period = "am" then
            return "a.m.";
         elsif Period = "pm" then
            return "p.m.";
         end if;
      elsif Lang = "ro" then
         if Period = "midnight" then
            return "miezul nop" & U (16#21B#) & "ii";
         elsif Period = "noon" then
            return "amiaz" & U (16#103#);
         elsif Period = "am" then
            return "a.m.";
         elsif Period = "pm" then
            return "p.m.";
         end if;
      elsif Lang = "lt" then
         if Period = "midnight" then
            return "vidurnaktis";
         elsif Period = "noon" then
            return "vidurdienis";
         elsif Period = "am" then
            return "prie" & U (16#161#) & "piet";
         elsif Period = "pm" then
            return "popiet";
         end if;
      elsif Lang = "sl" then
         if Period = "midnight" then
            return "polno" & U (16#10D#);
         elsif Period = "noon" then
            return "poldan";
         elsif Period = "am" then
            return "dop.";
         elsif Period = "pm" then
            return "pop.";
         end if;
      elsif Lang = "pl" then
         if Period = "midnight" then
            return "p" & U (16#F3#) & U (16#142#) & "noc";
         elsif Period = "noon" then
            return "po" & U (16#142#) & "udnie";
         elsif Period = "am" then
            return "AM";
         elsif Period = "pm" then
            return "PM";
         end if;
      elsif Lang = "cs" then
         if Period = "midnight" then
            return "p" & U (16#16F#) & "lnoc";
         elsif Period = "noon" then
            return "poledne";
         elsif Period = "am" then
            return "dop.";
         elsif Period = "pm" then
            return "odp.";
         end if;
      elsif Lang = "ru" then
         if Period = "midnight" then
            return U (16#43F#) & U (16#43E#) & U (16#43B#)
              & U (16#43D#) & U (16#43E#) & U (16#447#)
              & U (16#44C#);
         elsif Period = "noon" then
            return U (16#43F#) & U (16#43E#) & U (16#43B#)
              & U (16#434#) & U (16#435#) & U (16#43D#)
              & U (16#44C#);
         elsif Period = "am" then
            return "AM";
         elsif Period = "pm" then
            return "PM";
         end if;
      elsif Lang = "ar" then
         if Period = "midnight" then
            return U (16#645#) & U (16#646#) & U (16#62A#)
              & U (16#635#) & U (16#641#) & " "
              & U (16#627#) & U (16#644#) & U (16#644#)
              & U (16#64A#) & U (16#644#);
         elsif Period = "noon" then
            return U (16#638#) & U (16#647#) & U (16#631#)
              & U (16#64B#) & U (16#627#);
         elsif Period = "am" then
            return U (16#635#);
         elsif Period = "pm" then
            return U (16#645#);
         end if;
      elsif Lang = "ja" then
         if Period = "midnight" then
            return U (16#771F#) & U (16#591C#) & U (16#4E2D#);
         elsif Period = "noon" then
            return U (16#6B63#) & U (16#5348#);
         elsif Period = "am" then
            return U (16#5348#) & U (16#524D#);
         elsif Period = "pm" then
            return U (16#5348#) & U (16#5F8C#);
         end if;
      elsif Lang = "zh" then
         if Period = "midnight" then
            return U (16#5348#) & U (16#591C#);
         elsif Period = "noon" then
            return U (16#4E2D#) & U (16#5348#);
         elsif Period = "am" then
            return U (16#4E0A#) & U (16#5348#);
         elsif Period = "pm" then
            return U (16#4E0B#) & U (16#5348#);
         end if;
      elsif Lang = "ko" then
         if Period = "midnight" then
            return U (16#C790#) & U (16#C815#);
         elsif Period = "noon" then
            return U (16#C815#) & U (16#C624#);
         elsif Period = "am" then
            return U (16#C624#) & U (16#C804#);
         elsif Period = "pm" then
            return U (16#C624#) & U (16#D6C4#);
         end if;
      end if;

      if Period = "midnight" then
         return (if Wide then "midnight" else "mid.");
      elsif Period = "noon" then
         return "noon";
      elsif Period = "am" then
         return "AM";
      elsif Period = "pm" then
         return "PM";
      else
         return "";
      end if;
   end Day_Period_Name;

   function Era_Name
     (Locale   : String;
      Calendar : String;
      Era      : String)
      return String
   is
      Lang : constant String := Language (Locale);
   begin
      if Calendar = "gregorian" and then Era = "ad" then
         if Lang = "de" then
            return "n. Chr.";
         elsif Lang = "fr" then
            return "ap. J.-C.";
         elsif Lang = "es" then
            return "d. C.";
         elsif Lang = "it" then
            return "d.C.";
         elsif Lang = "pt" then
            return "d.C.";
         elsif Lang = "nl" then
            return "n.Chr.";
         elsif Lang = "ro" then
            return "d.Hr.";
         elsif Lang = "lt" then
            return "po Kr.";
         elsif Lang = "sl" then
            return "po Kr.";
         elsif Lang = "pl" then
            return "n.e.";
         elsif Lang = "cs" then
            return "n. l.";
         elsif Lang = "ru" then
            return U (16#43D#) & ". " & U (16#44D#) & ".";
         elsif Lang = "ar" then
            return U (16#645#);
         elsif Lang = "ja" then
            return U (16#897F#) & U (16#66A6#);
         elsif Lang = "zh" then
            return U (16#516C#) & U (16#5143#);
         elsif Lang = "ko" then
            return U (16#C11C#) & U (16#AE30#);
         else
            return "AD";
         end if;
      elsif Calendar = "japanese" and then Era = "reiwa" then
         return
           (if Lang = "ja"
            then U (16#4EE4#) & U (16#548C#)
            else "Reiwa");
      elsif Calendar = "japanese" and then Era = "heisei" then
         return
           (if Lang = "ja"
            then U (16#5E73#) & U (16#6210#)
            else "Heisei");
      elsif Calendar = "japanese" and then Era = "showa" then
         return
           (if Lang = "ja"
            then U (16#662D#) & U (16#548C#)
            else "Showa");
      elsif Calendar = "japanese" and then Era = "taisho" then
         return
           (if Lang = "ja"
            then U (16#5927#) & U (16#6B63#)
            else "Taisho");
      elsif Calendar = "japanese" and then Era = "meiji" then
         return
           (if Lang = "ja"
            then U (16#660E#) & U (16#6CBB#)
            else "Meiji");
      elsif Calendar = "japanese" and then Era = "keio" then
         return
           (if Lang = "ja"
            then U (16#6176#) & U (16#5FDC#)
            else "Keio");
      elsif Calendar = "roc" and then Era = "minguo" then
         return
           (if Lang = "zh"
            then U (16#6C11#) & U (16#570B#)
            else "Minguo");
      else
         return "";
      end if;
   end Era_Name;

   function Era_Year_Separator
     (Locale   : String;
      Calendar : String)
      return String
   is
      pragma Unreferenced (Locale, Calendar);
   begin
      return " ";
   end Era_Year_Separator;

