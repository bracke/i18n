         while Cut > Canon'First loop
            if Canon (Cut) = '-' then
               declare
                  Rows : constant String :=
                    Relative_Current_Row (Canon (Canon'First .. Cut - 1));
                  Hit : constant String := Search (Rows, Wanted);
               begin
                  if Hit /= "" then
                     return Hit;
                  end if;
               end;
            end if;
            Cut := Cut - 1;
         end loop;

         return "";
      end Walk;

      Rows : constant String := Relative_Current_Row (Locale);
      Exact : constant String := Search (Rows, Width);
   begin
      if Exact /= "" then
         return Exact;
      end if;

      --  The wanted width over the locale, then the full name,
      --  and only then the same two over its parents.
      if Width /= "unit-width-full-name" then
         declare
            Full_Exact : constant String :=
              Search (Rows, "unit-width-full-name");
         begin
            if Full_Exact /= "" then
               return Full_Exact;
            end if;
         end;
      end if;

      declare
         Fallback_Result : constant String := Walk (Width);
      begin
         if Fallback_Result /= "" then
            return Fallback_Result;
         end if;
      end;

      if Width /= "unit-width-full-name" then
         declare
            Full_Fallback : constant String :=
              Walk ("unit-width-full-name");
