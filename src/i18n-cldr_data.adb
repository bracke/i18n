         elsif Zone = "Asia/Ulaanbaatar" then "E"
         elsif Zone = "Asia/Yangon" then "F"
         elsif Zone = "Asia/Yerevan" then "G"
         elsif Zone = "Etc/UTC" then "H"
         elsif Zone = "Europe/Moscow" then "I"
         elsif Zone = "Pacific/Honolulu" then "J"
         else " ");

      --  One coded character, then the hex. The same scan serves
      --  both tables: by here a key is only a code.
      function Search (Rows : String; Wanted : String) return String is
         Start : Positive := Rows'First;
      begin
         if Wanted = " " then
            return "";
         end if;

         while Start <= Rows'Last loop
            declare
               Stop : Natural := Rows'Last + 1;
            begin
               for Index in Start .. Rows'Last loop
                  if Rows (Index) = '~' then
                     Stop := Index;
                     exit;
                  end if;
               end loop;

               if Stop > Start + 1
                 and then Rows (Start .. Start) = Wanted
               then
                  return VB (Rows (Start + 1 .. Stop - 1));
               end if;

               Start := Stop + 1;
            end;
         end loop;

         return "";
      end Search;

      --  The locale, then each parent, longest first.
      function Family_Display return String is
         Exact : constant String :=
           Search (Zone_Family_Display_Row (Locale), Family_Code);
         Canon : constant String := Canonical_Locale (Locale);
         Cut : Natural := Canon'Last;
      begin
         if Exact /= "" then
            return Exact;
         end if;

         while Cut > Canon'First loop
            if Canon (Cut) = '-' then
               declare
                  Hit : constant String :=
                    Search
                      (Zone_Family_Display_Row (Canon (Canon'First .. Cut - 1)),
                       Family_Code);
               begin
                  if Hit /= "" then
                     return Hit;
                  end if;
               end;
            end if;
            Cut := Cut - 1;
         end loop;

         return "";
      end Family_Display;

      --  The locale, then each parent, longest first.
      function Zone_Display return String is
         Exact : constant String :=
           Search (Zone_Display_Row (Locale), Zone_Code);
         Canon : constant String := Canonical_Locale (Locale);
         Cut : Natural := Canon'Last;
      begin
         if Exact /= "" then
            return Exact;
         end if;

         while Cut > Canon'First loop
            if Canon (Cut) = '-' then
               declare
                  Hit : constant String :=
                    Search
                      (Zone_Display_Row (Canon (Canon'First .. Cut - 1)),
                       Zone_Code);
               begin
                  if Hit /= "" then
                     return Hit;
                  end if;
               end;
            end if;
            Cut := Cut - 1;
         end loop;

         return "";
      end Zone_Display;
      Family_Value : constant String := Family_Display;
   begin
      if Family_Value /= "" then
         return Family_Value;
      end if;

      declare
         Zone_Value : constant String := Zone_Display;
      begin
         if Zone_Value /= "" then
