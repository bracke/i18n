         if Canonical then
            --  A locale spelled some other way does not sort where
            --  its canonical form would, so this one is a walk.
            for N in 1 .. Count loop
               declare
                  K : constant String := Key (N);
                  Stop : Natural := K'Last;
               begin
                  while Stop >= K'First and then K (Stop) = ' ' loop
                     Stop := Stop - 1;
                  end loop;
                  if Locale_Equals (Cand, K (K'First .. Stop)) then
                     return Value_At (N);
                  end if;
               end;
            end loop;
            return "";
         end if;

         declare
            Wanted : constant String := Padded (Cand);
         begin
            while Low <= High loop
               Mid := (Low + High) / 2;
               if Key (Mid) = Wanted then
                  return Value_At (Mid);
               elsif Key (Mid) < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end loop;
         end;
         return "";
      end Lookup;

      --  Bisect on the spelling as written, which answers almost
      --  every call; only a caller who spelled it some other way
      --  ("DE_at") pays for the walk.
      function Resolve (Cand : String) return String is
         Hit : constant String := Lookup (Cand, False);
      begin
         if Hit /= "" then
            return Hit;
         end if;
         return Lookup (Cand, True);
      end Resolve;

      --  Parents are cut from the canonical spelling: "de_AT" has
      --  no '-' to cut, and would otherwise lose its fallback.
      Canon : constant String := Canonical_Locale (Locale);
      Exact : constant String := Resolve (Locale);
      Cut : Natural := Canon'Last;
   begin
      if Exact /= "" then
         return Exact;
      end if;

      --  Then each parent, which is what the fallback pass did.
      while Cut > Canon'First loop
         if Canon (Cut) = '-' then
            declare
               Hit : constant String :=
                 Resolve (Canon (Canon'First .. Cut - 1));
            begin
               if Hit /= "" then
                  return Hit;
               end if;
            end;
         end if;
         Cut := Cut - 1;
      end loop;

      return "GMT";
   end GMT_Offset_Prefix;

   function Time_Zone_UTC_Designator (Locale : String) return String is
      pragma Unreferenced (Locale);
   begin
      return "Z";
   end Time_Zone_UTC_Designator;

   function Time_Zone_Offset_Separator (Locale : String) return String is
   begin
      if Locale_Equals (Locale, "da") then
         return ".";
      elsif Locale_Equals (Locale, "da-GL") then
         return ".";
      elsif Locale_Equals (Locale, "fi") then
         return ".";
      elsif Locale_Equals (Locale, "id") then
         return ".";
      elsif Locale_Equals (Locale, "ms-ID") then
         return ".";
      elsif Locale_Equals (Locale, "nds") then
         return ".";
      elsif Locale_Equals (Locale, "nds-NL") then
         return ".";
      elsif Locale_Equals (Locale, "si") then
         return ".";
      elsif Locale_Equals (Locale, "sl") then
         return ".";
      end if;

      if Locale_Fallback_Matches (Locale, "da") then
         return ".";
      elsif Locale_Fallback_Matches (Locale, "da-GL") then
         return ".";
      elsif Locale_Fallback_Matches (Locale, "fi") then
         return ".";
      elsif Locale_Fallback_Matches (Locale, "id") then
         return ".";
      elsif Locale_Fallback_Matches (Locale, "ms-ID") then
         return ".";
      elsif Locale_Fallback_Matches (Locale, "nds") then
         return ".";
      elsif Locale_Fallback_Matches (Locale, "nds-NL") then
         return ".";
      elsif Locale_Fallback_Matches (Locale, "si") then
         return ".";
      elsif Locale_Fallback_Matches (Locale, "sl") then
         return ".";
      end if;

      return ":";
   end Time_Zone_Offset_Separator;

