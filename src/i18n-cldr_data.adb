      Zone_Key_Width : constant := 34;
      Zone_Key_Count : constant Natural :=
        Zone_Index'Length / Zone_Key_Width;

      --  A zone name is thirty characters for one of 419, so the
      --  record carries a two-character code and the name is
      --  mapped once per call rather than compared per record.
      function Zone_Code return String is
         Low : Natural := 1;
         High : Natural := Zone_Key_Count;
         Mid : Natural;
         Wanted : constant String :=
           (if Zone'Length >= 32 then Zone (Zone'First .. Zone'First + 31)
            else Zone & (1 .. 32 - Zone'Length => ' '));
      begin
         while Low <= High loop
            Mid := (Low + High) / 2;
            declare
               At_Key : constant Natural :=
                 Zone_Index'First + (Mid - 1) * Zone_Key_Width;
               Key : constant String :=
                 Zone_Index (At_Key .. At_Key + 31);
            begin
               if Key = Wanted then
                  return Zone_Index (At_Key + 32 .. At_Key + 33);
               elsif Key < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end;
         end loop;

         return "  ";
      end Zone_Code;

      function Search (Rows : String; Wanted : String) return String is
         Start : Positive := Rows'First;
      begin
         if Wanted = "  " then
            return "";
         end if;

         while Start <= Rows'Last loop
            declare
               Stop : Natural := Rows'Last + 1;
            begin
               for Index in Start .. Rows'Last loop
                  if Rows (Index) = '~' then
                     Stop := Index;
                     exit;
                  end if;
               end loop;

               if Stop > Start + 2
                 and then Rows (Start .. Start + 1) = Wanted
               then
                  return VB (Rows (Start + 2 .. Stop - 1));
               end if;

               Start := Stop + 1;
            end;
         end loop;

         return "";
      end Search;

      --  The locale, then each parent, longest first.
      function Resolve return String is
         Wanted_Zone : constant String := Zone_Code;
         Exact : constant String :=
           Search (Zone_Exemplar_Row (Locale), Wanted_Zone);
         Canon : constant String := Canonical_Locale (Locale);
         Cut : Natural := Canon'Last;
      begin
         if Exact /= "" then
            return Exact;
         end if;

         while Cut > Canon'First loop
            if Canon (Cut) = '-' then
               declare
                  Hit : constant String :=
                    Search
                      (Zone_Exemplar_Row (Canon (Canon'First .. Cut - 1)),
                       Wanted_Zone);
               begin
                  if Hit /= "" then
                     return Hit;
                  end if;
               end;
            end if;
            Cut := Cut - 1;
         end loop;

         return "";
      end Resolve;
   begin
      return Resolve;
   end Time_Zone_Exemplar_Location;

