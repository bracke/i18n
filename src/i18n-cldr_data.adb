                      (Zone_Display_Row (Canon (Canon'First .. Cut - 1)),
                       Zone_Code);
               begin
                  if Hit /= "" then
                     return Hit;
                  end if;
               end;
            end if;
            Cut := Cut - 1;
         end loop;

         return "";
      end Zone_Display;
      Family_Value : constant String := Family_Display;
