         if List (Index) = ',' then
            if Matches (List (Start .. Index - 1)) then
               return True;
            end if;
            Start := Index + 1;
         end if;
      end loop;

      return Matches (List (Start .. List'Last));
   end Locale_In_List;

   function First_Day_Of_Week (Locale : String) return String is
   begin
      if Locale_In_List
        (Locale => Locale,
         List =>
           "en-001,en-AU,en-GB,en-IE,en-IN,en-NZ,de,fr,es,it,nl,"
           & "pl,pt,ru,ro,lt,sl,cs,da,sv,nb,nn,fi,tr,vi,uk,bg,"
           & "el,hu,sk,ca,eu,af,sw,eo",
         Include_Fallback => True)
      then
         return "mon";
      elsif Locale_In_List
        (Locale => Locale,
         List =>
           "ar-AE,ar-BH,ar-DJ,ar-DZ,ar-EG,ar-IQ,ar-JO,ar-KW,"
           & "ar-LY,ar-OM,ar-QA,ar-SD,ar-SY,ar-YE,fa-AF,fa-IR,"
           & "he-IL",
         Include_Fallback => True)
      then
         return "sat";
      elsif Locale_In_List
        (Locale => Locale,
         List => "ar-MV",
         Include_Fallback => True)
      then
         return "fri";
      else
         return "sun";
      end if;
   end First_Day_Of_Week;

