   function Currency_Name_From_Payload
     (Payload  : String;
      Code     : String;
      Category : String)
      return String
   is
      Start : Positive := Payload'First;
      Stop  : Natural;
      Last  : Natural;
      Slot_Start : Natural;
      Slot_End   : Natural;
      Slot       : Positive;
   begin
      if Code'Length /= 3 then
         return "";
      end if;

      if Category = "zero" then
         Slot := 1;
      elsif Category = "one" then
         Slot := 2;
      elsif Category = "two" then
         Slot := 3;
      elsif Category = "few" then
         Slot := 4;
      elsif Category = "many" then
         Slot := 5;
      else
         Slot := 6;
      end if;

      while Start <= Payload'Last loop
         Stop := Start;
         while Stop <= Payload'Last and then Payload (Stop) /= ';' loop
            Stop := Stop + 1;
         end loop;
         Last := Stop - 1;

         if Last >= Start + 4
           and then Payload (Start .. Start + 2) = Code
           and then Payload (Start + 3) = ':'
         then
            Slot_Start := Start + 4;
            Slot_End := Last;
            for Current in 1 .. Slot loop
               Slot_End := Last;
               for Index in Slot_Start .. Last loop
                  if Payload (Index) = ',' then
                     Slot_End := Index - 1;
                     exit;
                  end if;
               end loop;

               if Current = Slot then
                  if Slot_End >= Slot_Start then
                     return HB (Payload (Slot_Start .. Slot_End));
                  end if;
                  return "";
               end if;

               exit when Slot_End = Last;
               Slot_Start := Slot_End + 2;
            end loop;
         end if;

         Start := Stop + 1;
      end loop;

      return "";
   end Currency_Name_From_Payload;

   function Hex_List_Item (Items : String; Number : Positive) return String is
      Start : Positive := Items'First;
      Count : Positive := 1;
   begin
      for Index in Items'Range loop
         if Items (Index) = '~' then
            if Count = Number then
               if Index = Start then
                  return "";
               else
                  return H (Items (Start .. Index - 1));
               end if;
            end if;

            Count := Count + 1;
            if Index < Items'Last then
               Start := Index + 1;
            else
               Start := Items'Last;
            end if;
         end if;
      end loop;

      if Count = Number and then Start <= Items'Last then
         return H (Items (Start .. Items'Last));
      else
         return "";
      end if;
   end Hex_List_Item;

