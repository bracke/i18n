            when others => return [1 => Digit];
         end case;
         elsif Contains (Locale, "-u-nu-tnsa")
           or else Contains (Locale, "@numbers=tnsa")
         then
         case Digit is
            when '0' => return U (16#16AC0#);
            when '1' => return U (16#16AC1#);
            when '2' => return U (16#16AC2#);
            when '3' => return U (16#16AC3#);
            when '4' => return U (16#16AC4#);
