   function Era_Name
     (Locale   : String;
      Calendar : String;
      Era      : String)
      return String
   is
      Lang : constant String := Language (Locale);
   begin
      if Calendar = "gregorian" and then Era = "ad" then
         if Lang = "de" then
            return "n. Chr.";
         elsif Lang = "fr" then
            return "ap. J.-C.";
         elsif Lang = "es" then
            return "d. C.";
         elsif Lang = "it" then
            return "d.C.";
         elsif Lang = "pt" then
            return "d.C.";
         elsif Lang = "nl" then
            return "n.Chr.";
         elsif Lang = "ro" then
            return "d.Hr.";
         elsif Lang = "lt" then
            return "po Kr.";
         elsif Lang = "sl" then
            return "po Kr.";
         elsif Lang = "pl" then
            return "n.e.";
         elsif Lang = "cs" then
            return "n. l.";
         elsif Lang = "ru" then
            return U (16#43D#) & ". " & U (16#44D#) & ".";
         elsif Lang = "ar" then
            return U (16#645#);
         elsif Lang = "ja" then
            return U (16#897F#) & U (16#66A6#);
         elsif Lang = "zh" then
            return U (16#516C#) & U (16#5143#);
         elsif Lang = "ko" then
            return U (16#C11C#) & U (16#AE30#);
         else
            return "AD";
         end if;
      elsif Calendar = "japanese" and then Era = "reiwa" then
         return
           (if Lang = "ja"
            then U (16#4EE4#) & U (16#548C#)
            else "Reiwa");
      elsif Calendar = "japanese" and then Era = "heisei" then
         return
           (if Lang = "ja"
            then U (16#5E73#) & U (16#6210#)
            else "Heisei");
      elsif Calendar = "japanese" and then Era = "showa" then
         return
           (if Lang = "ja"
            then U (16#662D#) & U (16#548C#)
            else "Showa");
      elsif Calendar = "japanese" and then Era = "taisho" then
         return
           (if Lang = "ja"
            then U (16#5927#) & U (16#6B63#)
            else "Taisho");
      elsif Calendar = "japanese" and then Era = "meiji" then
         return
           (if Lang = "ja"
            then U (16#660E#) & U (16#6CBB#)
            else "Meiji");
      elsif Calendar = "japanese" and then Era = "keio" then
         return
           (if Lang = "ja"
            then U (16#6176#) & U (16#5FDC#)
            else "Keio");
      elsif Calendar = "roc" and then Era = "minguo" then
         return
           (if Lang = "zh"
            then U (16#6C11#) & U (16#570B#)
            else "Minguo");
      else
         return "";
      end if;
   end Era_Name;

