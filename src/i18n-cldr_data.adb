      --  The segment of Locale_Index holding the wanted skeleton.
      Segment_First : Natural := 0;
      Segment_Last : Natural := 0;

      function Key (N : Positive) return String is
        (Locale_Index (Locale_Index'First + (N - 1) * Width ..
                      Locale_Index'First + (N - 1) * Width + 13));

      function Padded (Cand : String) return String is
        (if Cand'Length >= 14 then Cand (Cand'First .. Cand'First + 13)
         else Cand & (1 .. 14 - Cand'Length => ' '));

