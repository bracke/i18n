   function Unit_Value_Separator (Locale : String) return String is
      Lang : constant String := Language (Locale);
   begin
      if Lang = "ja" or else Lang = "zh" or else Lang = "ko" then
         return "";
      else
         return " ";
      end if;
   end Unit_Value_Separator;

