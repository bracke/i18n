        (if Cand'Length >= 14 then Cand (Cand'First .. Cand'First + 13)
         else Cand & (1 .. 14 - Cand'Length => ' '));

      function Value_At (N : Positive) return String is
         Base : constant Natural :=
           Index_Data'First + (N - 1) * Width + 14;
         F : constant Natural :=
           Natural'Value (Index_Data (Base .. Base + 7));
         T : constant Natural :=
           Natural'Value (Index_Data (Base + 8 .. Base + 15));
      begin
         return HB (Values (F .. T));
      end Value_At;

      function Lookup (Cand : String; Canonical : Boolean) return String is
         Low : Natural := 1;
         High : Natural := Count;
         Mid : Natural;
      begin
         if Cand'Length = 0 or else Count = 0 then
            return "";
         end if;

         if Canonical then
            --  A locale spelled some other way does not sort where
            --  its canonical form would, so this one is a walk.
            for N in 1 .. Count loop
               declare
                  K : constant String := Key (N);
                  Stop : Natural := K'Last;
               begin
                  while Stop >= K'First and then K (Stop) = ' ' loop
                     Stop := Stop - 1;
                  end loop;
                  if Locale_Equals (Cand, K (K'First .. Stop)) then
                     return Value_At (N);
                  end if;
               end;
            end loop;
            return "";
         end if;

         declare
            Wanted : constant String := Padded (Cand);
         begin
            while Low <= High loop
               Mid := (Low + High) / 2;
               if Key (Mid) = Wanted then
                  return Value_At (Mid);
               elsif Key (Mid) < Wanted then
                  Low := Mid + 1;
               else
                  High := Mid - 1;
               end if;
            end loop;
         end;
         return "";
      end Lookup;

      --  Bisect on the spelling as written, which answers almost
      --  every call; only a caller who spelled it some other way
      --  ("DE_at") pays for the walk.
      function Resolve (Cand : String) return String is
         Hit : constant String := Lookup (Cand, False);
      begin
         if Hit /= "" then
            return Hit;
         end if;
         return Lookup (Cand, True);
      end Resolve;

      --  Parents are cut from the canonical spelling: "de_AT" has
      --  no '-' to cut, and would otherwise lose its fallback.
      Canon : constant String := Canonical_Locale (Locale);
      Exact : constant String := Resolve (Locale);
      Cut : Natural := Canon'Last;
   begin
      if Exact /= "" then
         return Exact;
      end if;

      --  Then each parent, which is what the fallback pass did.
      while Cut > Canon'First loop
         if Canon (Cut) = '-' then
            declare
               Hit : constant String :=
                 Resolve (Canon (Canon'First .. Cut - 1));
            begin
               if Hit /= "" then
                  return Hit;
               end if;
            end;
         end if;
         Cut := Cut - 1;
      end loop;

      return [1 => Character'Val (0)];
   end Relative_Offset_Suffix_Past_Row;

   function Relative_Offset_Suffix
     (Locale : String;
      Future : Boolean)
      return String
   is
      Lang : constant String := Language (Locale);
   begin
      declare
         Absent : constant String := [1 => Character'Val (0)];
         Row : constant String :=
           (if Future then Relative_Offset_Suffix_Future_Row (Locale)
            else Relative_Offset_Suffix_Past_Row (Locale));
      begin
         if Row /= Absent then
            return Row;
         end if;
      end;

      if Future then
         if Lang = "ja" then
            return U (16#5F8C#);
         elsif Lang = "zh" then
            return U (16#540E#);
         elsif Lang = "ko" then
            return " " & U (16#D6C4#);
         elsif Lang = "tr" then
            return " sonra";
         elsif Lang = "hu" then
            return UTF8 ([16#20#, 16#6D#, 16#FA#, 16#6C#, 16#76#, 16#61#]);
         elsif Lang = "fi" then
            return UTF8 ([16#20#, 16#70#, 16#E4#, 16#E4#, 16#73#, 16#74#, 16#E4#]);
         elsif Lang = "eu" then
            return " barru";
         else
            return "";
         end if;
      elsif Lang = "it" then
         return " fa";
      elsif Lang = "nl" then
         return " geleden";
      elsif Lang = "de" or else Lang = "fr" or else Lang = "es" or else Lang = "pt" then
         return "";
      elsif Lang = "ro" or else Lang = "lt" or else Lang = "sl" then
         return "";
      elsif Lang = "pl" then
         return " temu";
      elsif Lang = "ru" then
         return " " & U (16#43D#) & U (16#430#) & U (16#437#)
           & U (16#430#) & U (16#434#);
      elsif Lang = "cs" or else Lang = "ar" then
         return "";
      elsif Lang = "ja" or else Lang = "zh" then
         return U (16#524D#);
      elsif Lang = "ko" then
         return " " & U (16#C804#);
      elsif Lang = "tr" then
         return UTF8 ([16#20#, 16#F6#, 16#6E#, 16#63#, 16#65#]);
      elsif Lang = "sv" then
         return " sedan";
      elsif Lang = "da" then
         return " siden";
      elsif Lang = "vi" then
         return UTF8 ([16#20#, 16#74#, 16#72#, 16#1B0#, 16#1EDB#, 16#63#]);
      elsif Lang = "hu" then
         return UTF8 ([16#20#, 16#65#, 16#7A#, 16#65#, 16#6C#, 16#151#, 16#74#, 16#74#]);
      elsif Lang = "eo" or else Lang = "sk" or else Lang = "eu" then
         return "";
      elsif Lang = "fi" then
         return " sitten";
      elsif Lang = "no" then
         return " siden";
      elsif Lang = "id" then
         return " yang lalu";
      elsif Lang = "ms" then
         return " lalu";
      elsif Lang = "af" then
         return " gelede";
      elsif Lang = "sw" then
         return " iliyopita";
      else
         return " ago";
      end if;
   end Relative_Offset_Suffix;

