               declare
                  Key : constant String := Index_Key (N);
                  Stop : Natural := Key'Last;
               begin
                  while Stop >= Key'First
                    and then Key (Stop) = ' '
                  loop
                     Stop := Stop - 1;
                  end loop;
                  if Locale_Equals (Cand, Key (Key'First .. Stop)) then
                     Take (N);
                     return;
                  end if;
               end;
            end loop;
            return;
         end if;

         declare
            Wanted : constant String := Padded (Cand);
         begin
            while Low <= High loop
               Mid := (Low + High) / 2;
               declare
                  Key : constant String := Index_Key (Mid);
               begin
                  if Key = Wanted then
                     Take (Mid);
                     return;
                  elsif Key < Wanted then
                     Low := Mid + 1;
                  else
                     High := Mid - 1;
                  end if;
               end;
            end loop;
         end;
      end Segment;

      function In_Segment
        (First, Last : Natural;
         Wanted_Calendar : String)
         return String
      is
         Start : Natural := First;
         Fallback_First : Natural := 0;
         Fallback_Last : Natural := 0;
      begin
         if First = 0 then
            return "";
         end if;
         while Start <= Last loop
            declare
               Sep1 : Natural := 0;
               Sep2 : Natural := 0;
               Sep3 : Natural := 0;
               Stop : Natural := Last + 1;
            begin
               for Index in Start .. Last loop
                  if Style_Data (Index) = '|' then
                     if Sep1 = 0 then
                        Sep1 := Index;
                     elsif Sep2 = 0 then
                        Sep2 := Index;
                     elsif Sep3 = 0 then
                        Sep3 := Index;
                     end if;
                  elsif Style_Data (Index) = '~' then
                     Stop := Index;
                     exit;
                  end if;
               end loop;
               exit when Sep1 = 0 or else Sep2 = 0 or else Sep3 = 0;
               if Style_Data (Sep2 + 1 .. Sep3 - 1) = Style then
                  declare
                     Cal : constant String :=
                       Style_Data (Sep1 + 1 .. Sep2 - 1);
                  begin
                     if Cal = Wanted_Calendar then
                        return HB (Style_Data (Sep3 + 1 .. Stop - 1));
                     elsif Cal = "gregorian" then
                        Fallback_First := Sep3 + 1;
                        Fallback_Last := Stop - 1;
                     end if;
                  end;
               end if;
               Start := Stop + 1;
            end;
         end loop;
         if Fallback_First /= 0 then
            return HB (Style_Data (Fallback_First .. Fallback_Last));
         end if;
         return "";
      end In_Segment;

      function Search (Wanted_Calendar : String) return String is
         First, Last : Natural;
         Cut : Natural := Locale'Last;
      begin
         Segment (Locale, False, First, Last);
         declare
            Hit : constant String :=
              In_Segment (First, Last, Wanted_Calendar);
         begin
            if Hit /= "" then
               return Hit;
            end if;
         end;

         while Cut > Locale'First loop
            if Locale (Cut) = '-' then
               Segment
                 (Locale (Locale'First .. Cut - 1), False, First, Last);
               declare
                  Hit : constant String :=
                    In_Segment (First, Last, Wanted_Calendar);
               begin
                  if Hit /= "" then
                     return Hit;
                  end if;
               end;
            end if;
            Cut := Cut - 1;
         end loop;

         --  Nothing matched as spelled; retry accepting any
         --  spelling of the same locale.
         Segment (Locale, True, First, Last);
         return In_Segment (First, Last, Wanted_Calendar);
      end Search;

      Effective_Calendar : constant String :=
        (if Calendar = "" then "gregorian" else Calendar);
      Found : constant String := Search (Effective_Calendar);
   begin
      if Found /= "" then
         return Found;
      end if;

      --  Outside the pinned subset, fall back to the old shape rule.
      if In_List (Lang, "ja,zh") then
         if Style = "short" then
            return "yy'/'M'/'d";
         elsif Style = "full" then
            return "y'" & U (16#5E74#) & "'M'" & U (16#6708#) & "'d'" & U (16#65E5#) & "'EEEE";
         else
            return "y'" & U (16#5E74#) & "'M'" & U (16#6708#) & "'d'" & U (16#65E5#) & "'";
         end if;
      elsif Lang = "ko" then
         if Style = "short" then
            return "yy'/'M'/'d";
         elsif Style = "full" then
            return "y'" & U (16#B144#) & " 'M'" & U (16#C6D4#) & " 'd'" & U (16#C77C#) & " 'EEEE";
         else
            return "y'" & U (16#B144#) & " 'M'" & U (16#C6D4#) & " 'd'" & U (16#C77C#) & "'";
         end if;
      elsif DMY then
         if Style = "short" then
            return "dd'.'MM'.'yy";
         elsif Style = "long" or else Style = "full" then
            if Style = "full" then
               return "EEEE', 'd'. 'MMMM' 'yyyy";
            else
               return "d'. 'MMMM' 'yyyy";
            end if;
         else
            return "dd'.'MM'.'yyyy";
         end if;
      else
         if Style = "short" then
            return "M'/'d'/'yy";
         elsif Style = "long" or else Style = "full" then
            if Style = "full" then
               return "EEEE', 'MMMM' 'd', 'yyyy";
            else
               return "MMMM' 'd', 'yyyy";
            end if;
         elsif Style = "medium" then
            return "MMMM' 'd', 'yyyy";
         else
            return "yyyy'-'MM'-'dd";
         end if;
      end if;
   end Date_Style_Pattern;

   function Date_Style_Pattern
     (Locale : String;
      Style  : String)
      return String is
   begin
      return Date_Style_Pattern (Locale, "gregorian", Style);
   end Date_Style_Pattern;

   function Time_Style_Pattern
     (Locale     : String;
      Style      : String;
      Has_Second : Boolean)
      return String
   is
      Lang : constant String := Language (Locale);
   begin
      if Lang = "ko" then
         if Style = "long" or else Style = "full" then
            return "ah':'mm':'ss";
         elsif Style = "" or else Style = "medium" then
            return (if Has_Second then "ah':'mm':'ss" else "ah':'mm");
         else
            return "ah':'mm";
         end if;
      elsif Style = "long" or else Style = "full" then
         return "HH':'mm':'ss";
      elsif Style = "" or else Style = "medium" then
         return (if Has_Second then "HH':'mm':'ss" else "HH':'mm");
      else
         return "HH':'mm";
      end if;
   end Time_Style_Pattern;

