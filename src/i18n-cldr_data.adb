package body I18N.CLDR_Data is

   --  Generated by cldr/src/generate_cldr_data.adb.
   --  Source: cldr/data/cldr_subset.txt.
   --  Large generated lookup tables intentionally do not follow
   --  handwritten Ada style layout.
   pragma Style_Checks (Off);

   function U (Code : Natural) return String is
   begin
      if Code <= 16#7F# then
         return [1 => Character'Val (Code)];
      elsif Code <= 16#7FF# then
         return
           [1 => Character'Val (16#C0# + Code / 64),
            2 => Character'Val (16#80# + Code mod 64)];
      elsif Code <= 16#FFFF# then
         return
           [1 => Character'Val (16#E0# + Code / 4096),
            2 => Character'Val (16#80# + (Code / 64) mod 64),
            3 => Character'Val (16#80# + Code mod 64)];
      else
         return
           [1 => Character'Val (16#F0# + Code / 262144),
            2 => Character'Val (16#80# + (Code / 4096) mod 64),
            3 => Character'Val (16#80# + (Code / 64) mod 64),
            4 => Character'Val (16#80# + Code mod 64)];
      end if;
   end U;

   function B62_Value (C : Character) return Natural is
     (if C in 'a' .. 'z' then Character'Pos (C) - Character'Pos ('a')
      elsif C in 'A' .. 'Z'
      then 26 + Character'Pos (C) - Character'Pos ('A')
      else 52 + Character'Pos (C) - Character'Pos ('0'));

   function N62 (Text : String) return Natural is
      Value : Natural := 0;
   begin
      for C of Text loop
         Value := Value * 62 + B62_Value (C);
      end loop;

      return Value;
   end N62;

   --  Values are base64 of UTF-8 bytes, without padding: the
   --  offsets and the separators already say where one ends.
   function B64_Value (C : Character) return Natural is
     (if C in 'A' .. 'Z' then Character'Pos (C) - Character'Pos ('A')
      elsif C in 'a' .. 'z'
      then 26 + Character'Pos (C) - Character'Pos ('a')
      elsif C in '0' .. '9'
      then 52 + Character'Pos (C) - Character'Pos ('0')
      elsif C = '+' then 62
      else 63);

   function VB (Text : String) return String is
      Result : String (1 .. Text'Length * 3 / 4);
      Filled : Natural := 0;
      Index : Natural := Text'First;
   begin
      while Index <= Text'Last loop
         declare
            Left : constant Natural := Text'Last - Index + 1;
            C0 : constant Natural := B64_Value (Text (Index));
            C1 : constant Natural :=
              (if Left >= 2 then B64_Value (Text (Index + 1)) else 0);
            C2 : constant Natural :=
              (if Left >= 3 then B64_Value (Text (Index + 2)) else 0);
            C3 : constant Natural :=
              (if Left >= 4 then B64_Value (Text (Index + 3)) else 0);
         begin
            exit when Left < 2;
            Filled := Filled + 1;
            Result (Filled) := Character'Val (C0 * 4 + C1 / 16);
            if Left >= 3 then
               Filled := Filled + 1;
               Result (Filled) :=
                 Character'Val ((C1 mod 16) * 16 + C2 / 4);
            end if;
            if Left >= 4 then
               Filled := Filled + 1;
               Result (Filled) :=
                 Character'Val ((C2 mod 4) * 64 + C3);
            end if;
            Index := Index + 4;
         end;
      end loop;

      return Result (1 .. Filled);
   end VB;

   function Contains (Text : String; Fragment : String) return Boolean is
   begin
      if Fragment'Length = 0 or else Text'Length < Fragment'Length then
         return False;
      end if;

      for Index in Text'First .. Text'Last - Fragment'Length + 1 loop
         if Text (Index .. Index + Fragment'Length - 1) = Fragment then
            return True;
         end if;
      end loop;

      return False;
   end Contains;

   function Lower (C : Character) return Character is
   begin
      if C in 'A' .. 'Z' then
         return Character'Val (Character'Pos (C) + 32);
      end if;

      return C;
   end Lower;

   function In_List (Value : String; List : String) return Boolean is
      Start : Positive := List'First;
   begin
      for Index in List'Range loop
         if List (Index) = ',' then
            if Value = List (Start .. Index - 1) then
               return True;
            end if;
            Start := Index + 1;
         end if;
      end loop;

      return Value = List (Start .. List'Last);
   end In_List;

   function Language (Locale : String) return String is
      First : constant Positive := Locale'First;
   begin
      if Locale'Length < 2 then
         return "";
      end if;

      return Locale (First .. First + 1);
   end Language;

   function Canonical_Locale (Locale : String) return String is
      Buffer : String (1 .. 64) := [others => Character'Val (0)];
      Last   : Natural := 0;
   begin
      for C of Locale loop
         exit when Last = Buffer'Last;
         if C = '_' then
            Last := Last + 1;
            Buffer (Last) := '-';
         else
            Last := Last + 1;
            Buffer (Last) := Lower (C);
         end if;
      end loop;

      if Last = 0 then
         return "";
      else
         return Buffer (1 .. Last);
      end if;
   end Canonical_Locale;

   function Locale_Equals (Locale : String; Candidate : String) return Boolean is
   begin
      return Canonical_Locale (Locale) = Canonical_Locale (Candidate);
   end Locale_Equals;

   function Locale_Fallback_Matches
     (Locale    : String;
      Candidate : String)
      return Boolean
   is
      Current : String (1 .. 64) := [others => Character'Val (0)];
      Last    : Natural := 0;
      Target  : constant String := Canonical_Locale (Candidate);
   begin
      declare
         Canonical : constant String := Canonical_Locale (Locale);
      begin
         if Canonical'Length = 0 then
            return False;
         end if;

         Last := Natural'Min (Canonical'Length, Current'Length);
         Current (1 .. Last) := Canonical (Canonical'First .. Canonical'First + Last - 1);
      end;

      loop
         declare
            Dash : Natural := 0;
         begin
            for Index in reverse 1 .. Last loop
               if Current (Index) = '-' then
                  Dash := Index;
                  exit;
               end if;
            end loop;

            exit when Dash = 0;
            Last := Dash - 1;
            if Current (1 .. Last) = Target then
               return True;
            end if;
         end;
      end loop;

      return False;
   end Locale_Fallback_Matches;

   function Locale_In_List
     (Locale           : String;
      List             : String;
      Include_Fallback : Boolean)
      return Boolean
   is
      Start : Positive := List'First;

      function Matches (Candidate : String) return Boolean is
      begin
         if Locale_Equals (Locale, Candidate) then
            return True;
         elsif Include_Fallback then
            return Locale_Fallback_Matches (Locale, Candidate);
         else
            return False;
         end if;
      end Matches;
   begin
      for Index in List'Range loop
         if List (Index) = ',' then
            if Matches (List (Start .. Index - 1)) then
               return True;
            end if;
            Start := Index + 1;
         end if;
      end loop;

      return Matches (List (Start .. List'Last));
   end Locale_In_List;

