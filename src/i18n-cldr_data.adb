               return Full_Fallback;
            end if;
         end;
      end if;

      if Lang = "de" then
         if Base = "day" then
            return "heute";
         elsif Base = "week" then
            return "diese Woche";
         elsif Base = "month" then
            return "diesen Monat";
         elsif Base = "year" then
            return "dieses Jahr";
